{
  "manifest_version": 3,
  "name": "Total Recall",
  "version": "0.2.0",
  "description": "Capture pages into your Total Recall brain, recall what you already know, and chat with it beside any tab.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "sidePanel", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:*/*", "http://localhost:*/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Total Recall",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open the Total Recall side panel"
    },
    "remember-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Remember the current page (or the selected text)"
    }
  },
  "omnibox": { "keyword": "tr" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content-script.js"],
    "css": ["content-script.css"],
    "run_at": "document_idle"
  }],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
