messageId":"103","endLine":140,"endColumn":20,"suggestions":"105"},{"ruleId":"106","severity":2,"message":"107","line":36,"column":5,"endLine":36,"endColumn":15},{"ruleId":"101","severity":2,"message":"102","line":87,"column":60,"messageId":"103","endLine":87,"endColumn":63,"suggestions":"108"},{"ruleId":"109","severity":2,"message":"110","line":13,"column":5,"endLine":13,"endColumn":12},{"ruleId":"101","severity":2,"message":"102","line":23,"column":19,"messageId":"103","endLine":23,"endColumn":22,"suggestions":"111"},{"ruleId":"101","severity":2,"message":"102","line":38,"column":19,"messageId":"103","endLine":38,"endColumn":22,"suggestions":"112"},{"ruleId":"106","severity":2,"message":"113","line":23,"column":5,"endLine":23,"endColumn":15},"@typescript-eslint/no-explicit-any","Unexpected any. Specify a different type.","unexpectedAny",["114","115"],["116","117"],"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/greg/Github/total-recall/frontend/src/pages/FilesPage.tsx:36:5\n  34 |\n  35 |   useEffect(() => {\n> 36 |     fetchFiles()\n     |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  37 |   }, [fetchFiles])\n  38 |\n  39 |   return (",["118","119"],"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`loadTab` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\n/Users/greg/Github/total-recall/frontend/src/pages/SettingsPage.tsx:13:5\n  11 |\n  12 |   useEffect(() => {\n> 13 |     loadTab(activeTab);\n     |     ^^^^^^^ `loadTab` accessed before it is declared\n  14 |   }, [activeTab]);\n  15 |\n  16 |   const loadTab = async (file: string) => {\n\n/Users/greg/Github/total-recall/frontend/src/pages/SettingsPage.tsx:16:3\n  14 |   }, [activeTab]);\n  15 |\n> 16 |   const loadTab = async (file: string) => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 17 |     setLoading(true);\n     | ^^^^^^^^^^^^^^^^^^^^^\n> 18 |     setError(null);\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^\n> 27 |     }\n     | ^^^^^^^^^^^^^^^^^^^^^\n> 28 |   };\n     | ^^^^^ `loadTab` is declared here\n  29 |\n  30 |   const handleSave = async () => {\n  31 |     setSaving(true);",["120","121"],["122","123"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/greg/Github/total-recall/frontend/src/pages/TasksPage.tsx:23:5\n  21 |\n  22 |   useEffect(() => {\n> 23 |     fetchTasks()\n     |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  24 |   }, [fetchTasks])\n  25 |\n  26 |   return (",{"messageId":"124","fix":"125","desc":"126"},{"messageId":"127","fix":"128","desc":"129"},{"messageId"