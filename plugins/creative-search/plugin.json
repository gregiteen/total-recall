{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "creative-search",
  "name": "Creative Search",
  "version": "2.0.0",
  "description": "SearXNG-powered creative metasearch with categories, deep research, TR memory integration, engine stats, and health monitoring.",
  "author": "Total Recall",
  "license": "MIT",
  "use_cases": ["research", "search", "self-hosting", "knowledge-management"],
  "cli": {
    "command": "csearch",
    "handler": "./cli.mjs",
    "subcommands": [
      { "name": "query", "description": "Search for terms" },
      { "name": "health", "description": "Check SearXNG health" },
      { "name": "engines", "description": "List active engines" },
      { "name": "categories", "description": "Search with category filter" },
      { "name": "deep", "description": "Multi-step deep research" },
      { "name": "remember", "description": "Search and save to TR memory" },
      { "name": "stats", "description": "Engine health stats" }
    ]
  },
  "compile": {
    "generator": "./generator.mjs",
    "auto": true
  },
  "tasks": [
    {
      "intent": "Creative Search health check",
      "schedule": "*/30 * * * *",
      "command": "health"
    }
  ],
  "ui": {
    "design_tokens": "ui/DESIGN.md",
    "elements": [
      {
        "id": "csearch-main",
        "kind": "panel",
        "tag": "csearch-main",
        "module": "ui/csearch-main.js",
        "description": "Creative Search overview with branding, engine health, and quick commands",
        "events": [],
        "tokens": ["color-primary", "color-accent", "color-secondary", "color-success", "color-error", "color-warning", "color-text", "color-text-secondary", "color-text-tertiary", "color-surface", "color-surface-secondary", "color-border", "color-on-primary", "radius-sm", "radius-md", "radius-full", "spacing-xs", "spacing-sm", "spacing-md", "spacing-lg", "spacing-xl", "typography-body-size", "typography-h2-size", "typography-h3-size", "typography-caption-size", "font-family-ui", "font-family-mono"],
        "optional_tokens": []
      },
      {
        "id": "csearch-settings",
        "kind": "settings",
        "tag": "csearch-settings",
        "module": "ui/csearch-settings.js",
        "description": "Creative Search configuration: engines, categories, max results, auto-save",
        "events": ["settings-changed"],
        "tokens": ["color-primary", "color-success", "color-error", "color-text", "color-text-secondary", "color-text-tertiary", "color-surface", "color-surface-secondary", "color-border", "color-on-primary", "color-primary-hover", "color-surface-hover", "radius-sm", "radius-md", "radius-full", "spacing-xs", "spacing-sm", "spacing-md", "spacing-lg", "spacing-xl", "typography-body-size", "typography-caption-size", "font-family-ui"],
        "optional_tokens": []
      }
    ]
  }
}