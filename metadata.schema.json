{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/total-recall/total-recall/blob/main/metadata.schema.json",
  "title": "Total Recall Community Submission Metadata",
  "description": "Schema for skill and recipe submission metadata blocks in SKILL.md YAML frontmatter",
  "type": "object",
  "required": ["name", "description", "type", "schema_version"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Kebab-case slug, e.g. code-review"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300,
      "description": "One-sentence description of what this skill/recipe does"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "recipe"],
      "description": "Whether this is a standalone skill or a multi-step recipe"
    },
    "category": {
      "type": "string",
      "enum": ["engineering", "research", "writing", "planning", "data", "other"],
      "description": "Primary cognitive category"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "maxItems": 10,
      "description": "Searchable tags"
    },
    "author": {
      "type": "string",
      "description": "GitHub username of the submitter"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "requires_skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "For recipes: list of skill slugs this recipe depends on"
    },
    "schema_version": {
      "type": "integer",
      "const": 2,
      "description": "Must be 2 (SSSS schema version)"
    }
  }
}
