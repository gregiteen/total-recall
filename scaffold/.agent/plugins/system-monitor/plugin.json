{
  "$schema": "https://github.com/total-recall/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "system-monitor",
  "name": "System Monitor & Telemetry",
  "version": "1.0.0",
  "description": "Real-time host resource metrics, memory watchdog, and dynamic system telemetry context generator",
  "author": "Total Recall Ecosystem",
  "license": "MIT",
  "ssss_schemas": {
    "categories": [
      {
        "name": "system-metrics",
        "description": "Custom system-metrics memory nodes for System Monitor & Telemetry",
        "node_type": "memory"
      }
    ]
  },
  "cli": {
    "command": "system-monitor",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "status",
        "description": "Show System Monitor & Telemetry status"
      }
    ]
  },
  "compile": {
    "generator": "./generator.mjs",
    "auto": true
  },
  "tasks": [
    {
      "intent": "Periodic health verification for system-monitor",
      "schedule": "0 * * * *"
    }
  ]
}
