# Derived/regenerable — rebuilt from the vault
memory-derived/
sessions/
*.backup
logs/
node_modules/

# Runtime, sensitive, or oversized — never versioned.
# Each of these broke a real backup before it was listed here:
#   memory-vault/.events/  append-only logs; one reached 306MB and GitHub
#                          hard-rejects blobs >100MB, killing every push.
#   browser-profile/       the rotation Chromium profile — live provider
#                          session cookies. As sensitive as secrets.enc.
#   .snapshots/            ~46MB vault tarballs stored inside the vault.
memory-vault/.events/
browser-profile/
.snapshots/
daemon.pid

# macOS AppleDouble resource forks ("._name" beside "name"). They appear
# whenever a brain is read from a non-HFS volume (NFS/SMB/exFAT) or restored
# through an archiver, and 160 of them landed in this brain on 2026-10-15.
# They are filesystem metadata, not memory: never version them.
._*
.DS_Store
