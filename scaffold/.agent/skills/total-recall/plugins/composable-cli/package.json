{
  "name": "tr-plugin-composable-cli",
  "version": "0.2.6",
  "type": "module",
  "description": "Total Recall composable CLI plugin: create, compose, register, test and safely run custom verbs; every command listed in the instruction surfaces.",
  "scripts": {
    "ssss": "ssss",
    "test": "node --test test/*.test.mjs",
    "export": "ssss export vault --profile sale --out dist/bundle.ucw.json",
    "validate": "ssss conformance --engine"
  },
  "dependencies": {
    "@gregiteen/ssss-cli": "0.14.5"
  },
  "license": "MIT",
  "files": [
    "cli.mjs",
    "plugin.json",
    "DESIGN.md",
    "README.md",
    "LICENSE",
    "examples/",
    "schemas/",
    "skills/",
    "src/",
    "!src/**/*.spec.mjs",
    "ui/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@ssss/cli": "npm:@gregiteen/ssss-cli@0.14.5"
  }
}
