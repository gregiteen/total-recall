{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "composable-cli",
  "name": "Composable CLI",
  "version": "0.2.6",
  "description": "Dynamic agent command composition engine with pipeline registration, versioning, and execution.",
  "author": "Total Recall contributors",
  "license": "MIT",
  "branding": {
    "name": "CmdSmith",
    "color": "#0891b2",
    "badge": "Pipeline Forge",
    "font": "space-grotesk"
  },
  "secrets": [],
  "gate": {
    "tasks": ["Turn a repeated sequence into a reusable command", "List, test or roll back a composed command"],
    "owned_commands": []
  },
  "cli": {
    "command": "composable-cli",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "status",
        "description": "Show which Composable CLI subcommands are implemented",
        "effect": "read"
      },
      {
        "name": "create",
        "description": "Create a new custom CLI command",
        "effect": "write"
      },
      {
        "name": "read",
        "description": "Show the source of a custom command",
        "effect": "read"
      },
      {
        "name": "update",
        "description": "Update an existing custom command",
        "effect": "write"
      },
      {
        "name": "remove",
        "description": "Delete a custom command",
        "effect": "destructive"
      },
      {
        "name": "list",
        "description": "List all custom commands in scope",
        "effect": "read"
      },
      {
        "name": "show",
        "description": "Show command metadata and source",
        "effect": "read"
      },
      {
        "name": "history",
        "description": "Show version history of a command",
        "effect": "read"
      },
      {
        "name": "rollback",
        "description": "Roll back a command to a previous version",
        "effect": "write"
      },
      {
        "name": "test",
        "description": "Run the selected composed command test and return its actual outcome",
        "effect": "write",
        "timeout_ms": 125000
      },
      { "name": "test-path", "description": "Locate a test file without running it", "effect": "read" },
      {
        "name": "promote",
        "description": "Promote a command into a plugin directory",
        "effect": "write"
      },
      {
        "name": "library",
        "description": "Discover installed plugin operations and scoped composed commands without execution",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "plugin",
            "label": "Plugin ID",
            "type": "string",
            "flag": "--plugin",
            "required": false
          }
        ]
      }
    ]
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "skills": [
    {
      "id": "composable-cli",
      "path": "./skills/composable-cli/SKILL.md",
      "description": "Total Recall composable CLI plugin: create, compose, register, test and safely run custom verbs; every command listed in the instruction surfaces."
    }
  ],
  "ui": {
    "home": "home",
    "design_tokens": "DESIGN.md",
    "elements": [
      {
        "id": "home",
        "kind": "panel",
        "tag": "tr-composable-cli-home",
        "module": "ui/home.js",
        "description": "CmdSmith Home: composed commands, their records and history, with on-demand test, rollback and remove",
        "tokens": [
          "color-background",
          "color-secondary",
          "color-surface",
          "color-surface-raised",
          "color-line",
          "color-text",
          "color-muted",
          "color-primary",
          "color-primary-strong",
          "color-primary-soft",
          "color-on-primary",
          "color-ok",
          "color-ok-soft",
          "color-warn",
          "color-warn-soft",
          "color-danger",
          "color-danger-soft",
          "color-info",
          "color-info-soft",
          "spacing-xs",
          "spacing-sm",
          "spacing-md",
          "spacing-lg",
          "spacing-touch",
          "radius-sm",
          "radius-md",
          "radius-lg",
          "typography-title-font-family",
          "typography-title-font-size",
          "typography-title-font-weight",
          "typography-title-line-height",
          "typography-body-font-family",
          "typography-body-font-size",
          "typography-body-line-height",
          "typography-label-font-family",
          "typography-label-font-size",
          "typography-label-font-weight",
          "typography-label-letter-spacing",
          "typography-code-font-family",
          "typography-code-font-size",
          "typography-code-line-height"
        ]
      }
    ]
  },
  "ssss_schemas": {
    "categories": [
      {
        "name": "composable-commands",
        "description": "Registered composable CLI commands and aliases",
        "node_type": "memory"
      },
      {
        "name": "composed-workflows",
        "description": "Composed multi-step CLI workflow definitions",
        "node_type": "memory"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "status": {
    "command": "status",
    "refresh_seconds": 300
  },
  "distribution": {
    "tier": "official",
    "license": "open"
  }
}
