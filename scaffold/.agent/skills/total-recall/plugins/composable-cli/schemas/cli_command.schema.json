{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gregiteen/tr-plugin-composable-cli/schemas/cli_command.schema.json",
  "title": "CLI Command",
  "description": "SSSS document type for a registered composable CLI command. Lives beside the command's .mjs file as <scope dir>/commands/<name>.md.",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "cli_command",
      "description": "SSSS document type marker"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable UUID identifying this command registration"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "Command name invoked as `total-recall <name>`"
    },
    "scope": {
      "type": "string",
      "enum": ["project", "group", "global"],
      "description": "Visibility scope of the command"
    },
    "owner_project": {
      "type": "string",
      "format": "uuid",
      "description": "Project UUID that owns this command (scope=project)"
    },
    "group": {
      "type": "string",
      "format": "uuid",
      "description": "Group UUID for group-scoped commands (scope=group)"
    },
    "risk": {
      "type": "string",
      "enum": ["read", "write", "money", "dns-cert", "production-deploy", "secret-revoke"],
      "description": "Risk class governing dry-run / --yes behavior"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Current version number; incremented on every update"
    },
    "author": {
      "type": "string",
      "description": "Agent or user id that created the command"
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 creation timestamp"
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 last-updated timestamp"
    },
    "description": {
      "type": "string",
      "description": "Human-readable command description"
    },
    "background_allowed": {
      "type": "boolean",
      "description": "Whether the command supports --background execution"
    },
    "code_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hash of the current command file content"
    },
    "last_test": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last test run"
    },
    "last_test_ok": {
      "type": "boolean",
      "description": "Whether the last test run passed"
    },
    "source": {
      "type": "string",
      "enum": ["inline", "from-plugin", "config-for-skill", "upgraded", "nickname"],
      "description": "How the command was created"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Arbitrary tags for categorization"
    }
  },
  "required": [
    "type",
    "id",
    "name",
    "scope",
    "risk",
    "version",
    "author",
    "created",
    "updated"
  ],
  "additionalProperties": false
}