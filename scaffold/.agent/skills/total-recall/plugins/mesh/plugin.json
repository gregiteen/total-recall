{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "mesh",
  "name": "Headscale",
  "version": "0.2.3",
  "description": "Control-server mesh administration, Tailscale SSH, and peer node discovery.",
  "license": "MIT",
  "requires": [
    {
      "id": "auth",
      "range": ">=1.2.1"
    }
  ],
  "branding": {
    "name": "Headscale",
    "color": "#818cf8",
    "badge": "Mesh Topology",
    "font": "space-grotesk",
    "logo": "ui/logo.svg",
    "provider": {
      "name": "Headscale",
      "url": "https://headscale.net"
    }
  },
  "card_face": {
    "skin": "mesh-telemetry",
    "theme": "vibrant",
    "headline": "Mesh Control Deck",
    "primary_color": "#2563eb",
    "secondary_color": "#1e3a8a",
    "accent_color": "#3b82f6",
    "quick_actions": [
      {
        "subcommand": "status",
        "label": "STATUS"
      },
      {
        "subcommand": "nodes",
        "label": "NODES"
      },
      {
        "subcommand": "doctor",
        "label": "DOCTOR"
      },
      {
        "subcommand": "leader",
        "label": "LEADER"
      }
    ],
    "touch_layout": "comfortable",
    "interactive": true
  },
  "ssss_schemas": {
    "categories": [
      {
        "name": "mesh-nodes",
        "description": "Custom mesh-nodes memory nodes for Mesh",
        "node_type": "memory"
      },
      {
        "name": "mesh-events",
        "description": "SSSS event logs and telemetry for Mesh",
        "node_type": "memory"
      }
    ]
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "secrets": [
    {
      "key": "HEADSCALE_API_KEY",
      "description": "Mesh service API key (paste it in the plugin UI)",
      "required": true
    }
  ],
  "cli": {
    "command": "mesh",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "file",
        "description": "Transfer a file through authenticated mesh access and verify its destination hash",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "operation",
            "label": "Operation",
            "type": "string",
            "positional": true,
            "required": true
          },
          {
            "name": "node",
            "label": "Node",
            "type": "string",
            "positional": true,
            "required": true
          },
          {
            "name": "source",
            "label": "Source",
            "type": "string",
            "positional": true,
            "required": true
          },
          {
            "name": "destination",
            "label": "Destination",
            "type": "string",
            "positional": true,
            "required": true
          }
        ]
      },
      {
        "name": "status",
        "description": "Inspect live mesh state",
        "effect": "read"
      },
      {
        "name": "view",
        "description": "Read independent owner observations for mesh screens",
        "effect": "read",
        "timeout_ms": 60000,
        "args": [
          {
            "name": "screen",
            "label": "Screen",
            "type": "choice",
            "positional": true,
            "options": [
              "machines",
              "flows",
              "placement",
              "boundary",
              "join"
            ]
          },
          {
            "name": "json",
            "label": "JSON output",
            "type": "boolean",
            "flag": "--json"
          }
        ]
      },
      {
        "name": "nodes",
        "description": "Mesh nodes operation",
        "effect": "read"
      },
      {
        "name": "doctor",
        "description": "Mesh doctor operation",
        "effect": "read"
      },
      {
        "name": "ssh",
        "description": "Mesh ssh operation",
        "effect": "write"
      },
      {
        "name": "exec",
        "description": "Mesh exec operation",
        "effect": "write"
      },
      {
        "name": "access",
        "timeout_ms": 180000,
        "description": "Mesh access operation",
        "effect": "write"
      },
      {
        "name": "ping",
        "description": "Mesh ping operation",
        "effect": "read"
      },
      {
        "name": "leader",
        "description": "Mesh leader operation",
        "effect": "read"
      },
      {
        "name": "enroll",
        "description": "Mesh enroll operation",
        "effect": "destructive"
      },
      {
        "name": "preauthkey",
        "description": "Mesh preauthkey operation",
        "effect": "write"
      },
      {
        "name": "policy",
        "description": "Mesh policy operation",
        "effect": "write"
      },
      {
        "name": "probe",
        "description": "Mesh probe operation",
        "effect": "read"
      },
      {
        "name": "token",
        "description": "Mesh token operation",
        "effect": "write"
      },
      {
        "name": "presence",
        "description": "Mesh presence operation",
        "effect": "read"
      },
      {
        "name": "dispatch",
        "description": "Mesh dispatch operation",
        "effect": "send"
      },
      {
        "name": "server",
        "description": "Provision, update and inspect your own Headscale control server on a host you deploy to",
        "effect": "write"
      },
      {
        "name": "grants",
        "description": "List, add or remove which enrolled machines may read which secret keys",
        "effect": "write"
      }
    ]
  },
  "ui": {
    "design_tokens": "ui/DESIGN.md",
    "elements": [
      {
        "id": "panel",
        "kind": "panel",
        "tag": "mesh-panel",
        "module": "ui/panel.js",
        "description": "Mesh panel",
        "events": [
          "save-token"
        ],
        "tokens": [
          "color-text",
          "color-surface",
          "color-border",
          "spacing-md",
          "radius-md"
        ],
        "optional_tokens": [],
        "props": {
          "view": {
            "type": "object",
            "description": "Printed by `total-recall mesh token status --json`: { present, secretKey }"
          }
        }
      },
      {
        "id": "card",
        "kind": "card",
        "tag": "tr-mesh-card",
        "module": "ui/card.js",
        "description": "Meshlink Card Face"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "runtime": {
    "modules": {
      "mesh": "src/core/mesh.mjs",
      "mesh-access": "src/core/mesh-access.mjs",
      "mesh-access-sync": "src/core/mesh-access-sync.mjs",
      "mesh-auth": "src/core/mesh-auth.mjs",
      "mesh-identity": "src/core/mesh-identity.mjs",
      "mesh-activity": "src/core/mesh-activity.mjs",
      "mesh-discover": "src/core/mesh-discover.mjs",
      "mesh-enroll": "src/core/mesh-enroll.mjs",
      "mesh-late-bind": "src/core/mesh-late-bind.mjs",
      "tailscale-cli": "src/core/tailscale-cli.mjs",
      "headscale-client": "src/core/headscale-client.mjs",
      "leader-election": "src/core/leader-election.mjs",
      "network-interfaces": "src/core/network-interfaces.mjs",
      "lan-discovery": "src/core/lan-discovery.mjs",
      "device-io": "src/core/device-io.mjs",
      "registration-watch": "src/core/registration-watch.mjs",
      "plugin-peers": "src/core/plugin-peers.mjs",
      "cli": "src/cli/mesh.mjs",
      "route-mesh": "src/server/routes/mesh.mjs",
      "route-mesh-presence": "src/server/routes/mesh-presence.mjs",
      "route-headscale": "src/server/routes/headscale.mjs",
      "route-plugins-mesh": "src/server/routes/plugins-mesh.mjs",
      "status": "src/core/status.mjs",
      "credentials": "src/core/credentials.mjs",
      "presence": "src/core/presence.mjs"
    },
    "routers": [
      "src/server/routes/mesh.mjs",
      "src/server/routes/mesh-presence.mjs",
      "src/server/routes/headscale.mjs",
      "src/server/routes/plugins-mesh.mjs"
    ]
  },
  "configuration": {
    "fields": [
      {
        "name": "controlUrl",
        "label": "Control server URL",
        "type": "string",
        "required": false
      }
    ]
  },
  "tasks": [
    {
      "intent": "Keep the Headscale control server current",
      "schedule": "17 4 * * *",
      "command": "server update --if-provisioned"
    }
  ],
  "status": {
    "command": "status",
    "refresh_seconds": 15
  },
  "distribution": {
    "tier": "official",
    "license": "open"
  },
  "mesh": {
    "version": 1,
    "description": "Declared support and observation contracts; declarations are not live readiness or primitive grants.",
    "provides": [
      {
        "id": "node-inventory",
        "operation": "status",
        "runtime": "mesh",
        "observation": "machines.status"
      },
      {
        "id": "execution-probe",
        "operation": "doctor",
        "runtime": "mesh",
        "observation": "doctor"
      },
      {
        "id": "remote-execution",
        "operation": "exec",
        "runtime": "mesh",
        "observation": "doctor"
      },
      {
        "id": "path-probe",
        "operation": "ping",
        "runtime": "mesh",
        "observation": "ping"
      },
      {
        "id": "presence",
        "operation": "presence",
        "runtime": "presence",
        "observation": "machines.presence"
      },
      {
        "id": "file-push",
        "operation": "file",
        "runtime": "mesh",
        "observation": null
      },
      {
        "id": "secret-grants",
        "operation": "grants",
        "runtime": "mesh-identity",
        "observation": "flows.grants"
      },
      {
        "id": "control-policy",
        "operation": "policy",
        "runtime": "headscale-client",
        "observation": "boundary.policy"
      },
      {
        "id": "enrollment",
        "operation": "enroll",
        "runtime": "mesh-enroll",
        "observation": "join.status"
      }
    ],
    "integrations": [
      {
        "id": "auth",
        "owner": "auth",
        "purpose": "One host credential store; no values in views",
        "observation": "machines.status",
        "evidence": "control.verified"
      },
      {
        "id": "headscale",
        "owner": "mesh",
        "purpose": "Control server authentication and membership",
        "observation": "machines.status",
        "evidence": "control.verified"
      },
      {
        "id": "tailscale",
        "owner": "mesh",
        "purpose": "Client enrollment and mesh network state",
        "observation": "machines.status",
        "evidence": "network_available"
      },
      {
        "id": "ssh",
        "owner": "mesh",
        "purpose": "Per-machine execution probes",
        "observation": "doctor",
        "evidence": "reachable per machine"
      },
      {
        "id": "presence",
        "owner": "mesh",
        "purpose": "Authenticated fresh activity observations",
        "observation": "machines.presence",
        "evidence": "peer states and timestamps"
      },
      {
        "id": "plugin-sharing",
        "owner": "mesh",
        "purpose": "Peer plugin inventories",
        "observation": "flows.plugins",
        "evidence": "peer status"
      },
      {
        "id": "updates",
        "owner": "core",
        "purpose": "Last automatic maintenance report",
        "observation": "flows.updates",
        "evidence": "recorded last result"
      },
      {
        "id": "schedules",
        "owner": "user-automations",
        "purpose": "Task declarations and node placement",
        "observation": "flows.tasks",
        "evidence": "node inventory; no execution inferred"
      },
      {
        "id": "agents",
        "owner": "core",
        "purpose": "Running and recent process inventory",
        "observation": "flows.agents",
        "evidence": "process records"
      },
      {
        "id": "alerts",
        "owner": "operator-alerts",
        "purpose": "Recorded delivery attempts",
        "observation": "flows.alerts",
        "evidence": "ledger result; no recipient view inferred"
      },
      {
        "id": "deployments",
        "owner": "deploy",
        "purpose": "Selected project release state",
        "observation": "flows.deployments",
        "evidence": "configured slot; no fleet-wide inference"
      }
    ],
    "endpoints": [
      {
        "path": "/api/mesh/presence/local",
        "method": "GET",
        "runtime": "route-mesh-presence",
        "authentication": "mesh peer"
      },
      {
        "path": "/api/mesh/plugins",
        "method": "GET",
        "runtime": "route-plugins-mesh",
        "authentication": "mesh peer"
      }
    ],
    "task_placement": "Declared task placement is selected-node or per-node; actual execution requires a verified daemon report.",
    "unavailable": [
      "transfer-history",
      "service-health-cli",
      "exit-node-management",
      "subnet-route-management",
      "tunnel-inventory",
      "public-exposure-inventory",
      "speed-measurement",
      "messages",
      "shared-file-spaces"
    ]
  },
  "capability": {
    "entry": "capability/index.mjs",
    "dependencies": [],
    "exports": [
      "createControlServer",
      "createHeadscaleApi",
      "buildMeshSshPolicy",
      "meshTargetOf",
      "sshExec",
      "assertSecureControlUrl",
      "normalizeControlUrl",
      "shellQuote",
      "patchConfig",
      "parseChecksum",
      "consoleConfig"
    ]
  }
}
