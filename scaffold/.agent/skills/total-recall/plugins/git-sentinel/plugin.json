{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "git-sentinel",
  "name": "Git Sentinel",
  "version": "1.1.5",
  "description": "Worktree hygiene, branch inspection, unpushed commits, and stash tracker.",
  "author": "Total Recall",
  "license": "MIT",
  "use_cases": [
    "software-development"
  ],
  "gate": {
    "tasks": ["Check a repository's state before committing or pushing", "Review what changed in a working tree", "Read the commit identity"],
    "owned_commands": [
      { "pattern": "git(\\s+-C\\s+\\S+)?\\s+status\\b", "use": "total-recall git-sentinel audit" },
      { "pattern": "git(\\s+-C\\s+\\S+)?\\s+stash\\s+list\\b", "use": "total-recall git-sentinel audit" },
      { "pattern": "git(\\s+-C\\s+\\S+)?\\s+diff\\s+--stat\\b", "use": "total-recall git-sentinel diff" },
      { "pattern": "git(\\s+-C\\s+\\S+)?\\s+config\\s+(--get\\s+)?user\\.(name|email)\\s*($|[;&|])", "use": "total-recall git-sentinel identity" },
      { "pattern": "git(\\s+-C\\s+\\S+)?\\s+log\\b[^;&|]*%a[en]", "use": "total-recall git-sentinel identity" }
    ]
  },
  "cli": {
    "answers_help": true,
    "command": "git-sentinel",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "audit",
        "description": "Summarise branch, worktree, upstream and stash state (--json for machine output)",
        "effect": "read"
      },
      {
        "name": "diff",
        "description": "Read a stat or patch for unstaged, staged or base-relative changes",
        "effect": "read",
        "args": [
          { "name": "patch", "flag": "--patch", "type": "boolean", "label": "Show patch" },
          { "name": "cached", "flag": "--cached", "type": "boolean", "label": "Use staged changes" },
          { "name": "base", "flag": "--base", "type": "string", "label": "Base ref" }
        ]
      },
      { "name": "worktree-list", "description": "Read registered worktrees for the current repository", "effect": "read" },
      { "name": "worktree-create", "description": "Create a detached worktree at a specified path and base ref", "effect": "write", "args": [
        { "name": "path", "type": "string", "label": "Worktree path", "required": true, "positional": true },
        { "name": "base", "flag": "--base", "type": "string", "label": "Base ref" }
      ] },
      { "name": "worktree-remove", "description": "Remove an owned linked worktree, with explicit force for dirty content", "effect": "destructive", "args": [
        { "name": "path", "type": "string", "label": "Worktree path", "required": true, "positional": true },
        { "name": "force", "flag": "--force", "type": "boolean", "label": "Allow removal of dirty content" }
      ] },
      { "name": "worktree", "description": "Compatibility form: worktree list, create or remove", "effect": "destructive" },
      {
        "name": "identity",
        "description": "Show who commits here and which identities the history publishes; exits 1 on a missing or machine-derived identity (--json for machine output)",
        "effect": "read"
      }
    ]
  },
  "ui": {
    "design_tokens": "DESIGN.md",
    "home": "repository",
    "elements": [
      {
        "id": "repository",
        "kind": "panel",
        "tag": "git-sentinel-home",
        "module": "ui/home.js",
        "description": "Repository audit, diff stats, and linked worktrees",
        "tokens": ["color-text", "color-surface", "color-border", "spacing-md", "radius-md"],
        "optional_tokens": [
          "color-background", "color-accent", "color-muted", "color-danger",
          "typography-body-font-family", "typography-heading-font-family", "typography-mono-font-family"
        ]
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "branding": {
    "name": "Git Hygiene",
    "color": "#b45309",
    "accent": "#f59e0b",
    "badge": "Repository Hygiene",
    "font": "space-grotesk"
  },
  "status": {
    "command": "audit",
    "refresh_seconds": 60
  },
  "distribution": {
    "tier": "official",
    "license": "open"
  }
}
