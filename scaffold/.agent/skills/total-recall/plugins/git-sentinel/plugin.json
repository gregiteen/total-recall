{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "git-sentinel",
  "name": "Git Hygiene",
  "version": "1.1.2",
  "description": "Worktree hygiene, branch inspection, unpushed commits, and stash tracker.",
  "author": "Total Recall",
  "license": "MIT",
  "use_cases": [
    "software-development"
  ],
  "cli": {
    "command": "git-sentinel",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "audit",
        "description": "Summarise branch, worktree, upstream and stash state (--json for machine output)",
        "effect": "read"
      },
      {
        "name": "diff",
        "description": "Show a diffstat of unstaged changes",
        "effect": "read"
      }
    ]
  },
  "card_face": {
    "skin": "copper-obsidian",
    "theme": "copper",
    "headline": "Worktree Hygiene & Repository Watch",
    "primary_color": "#b45309",
    "secondary_color": "#0c0a09",
    "accent_color": "#f59e0b",
    "touch_layout": "comfortable",
    "interactive": true,
    "quick_actions": [
      {
        "subcommand": "audit",
        "label": "AUDIT"
      },
      {
        "subcommand": "diff",
        "label": "DIFFSTAT"
      }
    ]
  },
  "ui": {
    "elements": [
      {
        "id": "card",
        "kind": "card",
        "tag": "tr-git-sentinel-card",
        "module": "ui/card.js",
        "description": "Git Hygiene Repository Hygiene Card Face"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "branding": {
    "name": "Git Hygiene",
    "color": "#b45309",
    "accent": "#f59e0b",
    "badge": "Repository Hygiene",
    "font": "space-grotesk"
  },
  "status": {
    "command": "audit",
    "refresh_seconds": 60
  },
  "distribution": {
    "tier": "official",
    "license": "open"
  },
  "card_layout": {
    "template": "dashboard",
    "regions": [
      {
        "widget": "status",
        "title": "Status"
      },
      {
        "widget": "live",
        "title": "Live view"
      },
      {
        "widget": "list",
        "title": "Details",
        "source": {
          "command": "diff"
        }
      },
      {
        "widget": "actions",
        "title": "Commands"
      },
      {
        "widget": "activity",
        "title": "Recent activity"
      }
    ]
  }
}
