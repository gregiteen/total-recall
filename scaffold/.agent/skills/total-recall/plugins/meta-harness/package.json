{
  "name": "tr-plugin-meta-harness",
  "version": "0.3.11",
  "description": "Total Recall Meta Harness plugin",
  "type": "module",
  "scripts": {
    "test": "node --import ./test/isolate.mjs --test test/*.test.mjs",
    "ssss": "ssss",
    "ssss:validate": "node src/verify-ssss.mjs --target ."
  },
  "files": [
    "cli.mjs",
    "plugin.json",
    "README.md",
    "DESIGN.md",
    "src/",
