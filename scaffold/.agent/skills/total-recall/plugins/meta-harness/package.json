    "ui/",
    "capability/",
    "skills/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gregiteen/ssss-cli": "0.14.5"
  },
  "overrides": {
    "@ssss/cli": "npm:@gregiteen/ssss-cli@0.14.5"
  }
}
