{
  "id": "meta-harness",
  "name": "Metaharness",
  "version": "0.3.11",
  "description": "Discover, configure, document, track, and run coding agent harnesses through Total Recall across mesh nodes.",
  "gate": {
    "tasks": ["Run work in another agent harness", "Choose which harness takes a task", "Check harness versions, sign-in and quota", "Read a harness's official documentation"],
    "router": {
      "pattern": "(meta-harness|cli-agents)\\s+(route|coordinate|orchestrate|dispatch)",
      "use": "total-recall meta-harness route \"<task>\" --json"
    },
    "owned_commands": [
      { "pattern": "claude\\s+[^;&|]*(-p|--print)\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "codex\\s+exec\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "agy\\s+[^;&|]*(-p|--print)\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "cursor-agent\\s", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "dsh\\s+[^;&|]*--profile\\s+headless\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "grok\\s+[^;&|]*-p\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "pi\\s+[^;&|]*--print\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "hermes\\s+chat\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "openclaw\\s+agent\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "aider\\s+[^;&|]*--message\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "goose\\s+run\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "cline\\s+task\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" },
      { "pattern": "muse\\s+exec\\b", "use": "total-recall meta-harness route \"<task>\" --execute --json" }
    ]
  },
  "cli": {
    "answers_help": true,
    "command": "meta-harness",
    "alias": "cli-agents",
    "handler": "cli.mjs",
    "subcommands": [
      {
        "name": "status",
        "description": "Inspect local agent binaries and authentication metadata",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "catalog",
        "description": "List documented adapter contracts and source references",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "chat-target",
        "description": "Resolve the default Chat harness and prepare a draft for the selected brains",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "brains",
            "flag": "--brains",
            "type": "string",
            "label": "Selected brain IDs, comma separated"
          }
        ]
      },
      {
        "name": "chat-default",
        "description": "Save the default Chat harness for every brain selection",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "adapter",
            "type": "string",
            "label": "Metaharness adapter ID",
            "required": true,
            "positional": true
          },
          {
            "name": "url",
            "flag": "--url",
            "type": "string",
            "label": "Optional Chat launch URL"
          }
        ]
      },
      {
        "name": "nodes",
        "description": "List recorded mesh targets without probing or changing them",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "inspect",
        "description": "Inspect installed harnesses on a selected node",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "node",
            "flag": "--node",
            "type": "string",
            "label": "Mesh node"
          }
        ],
        "timeout_ms": 120000
      },
      {
        "name": "adoption",
        "description": "Check installed agents, native gate activity and managed run receipts on this node or the mesh",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "node",
            "flag": "--node",
            "type": "string",
            "label": "Mesh node"
          },
          {
            "name": "all",
            "flag": "--all",
            "type": "boolean",
            "label": "Check the recorded fleet"
          }
        ],
        "timeout_ms": 120000
      },
      {
        "name": "run-command",
        "description": "Run an explicit plugin command through the selected agent and node using a JSON request on stdin",
        "effect": "write",
        "output": "json",
        "args": [],
        "timeout_ms": 600000
      },
      {
        "name": "runtime",
        "description": "Inspect a runtime or run supported maintenance; agent tasks use dispatch",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "type": "string",
            "label": "Agent adapter",
            "required": true,
            "positional": true
          },
          {
            "name": "operation",
            "type": "string",
            "label": "Maintenance operation",
            "required": true,
            "positional": true
          }
        ],
        "timeout_ms": 120000
      },
      {
        "name": "dispatch",
        "description": "Run a task from stdin after automatic Total Recall bootstrap",
        "effect": "write",
        "output": "json",
        "args": [],
        "timeout_ms": 600000
      },
      {
        "name": "included-status",
        "description": "Read included usage policy and optionally check Codex allowance without a turn",
        "effect": "read",
        "output": "json",
        "args": [{ "name": "probe", "flag": "--probe", "type": "boolean", "label": "Read live Codex allowance" }]
      },
      {
        "name": "included-enforce",
        "description": "Require included usage for managed agent dispatch on this node",
        "effect": "write",
        "output": "json",
        "args": []
      },
      {
        "name": "included-bind-claude",
        "description": "Bind verified Max credit evidence on stdin to an existing Auth key",
        "effect": "write",
        "output": "json",
        "args": []
      },
      {
        "name": "included-bind-claude-plan",
        "description": "Bind the signed-in Claude Max account after verifying Usage credits are off",
        "effect": "write",
        "output": "json",
        "args": []
      },
      {
        "name": "openrouter-bind",
        "description": "Authorize an explicit OpenRouter harness with a verified Total Recall Auth key and catalog model",
        "effect": "write",
        "output": "json",
        "args": [
          { "name": "agent", "type": "string", "label": "Harness", "required": true, "positional": true },
          { "name": "key", "type": "string", "label": "Auth key name", "required": true, "positional": true },
          { "name": "model", "flag": "--model", "type": "string", "label": "OpenRouter model ID", "required": true }
        ]
      },
      {
        "name": "usage-queue",
        "description": "List jobs waiting for included usage and their reset evidence",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "usage-retry",
        "description": "Retry a waiting job after checking included usage",
        "effect": "write",
        "output": "json",
        "args": [{ "name": "job", "type": "string", "label": "Queued job ID", "required": true, "positional": true }],
        "timeout_ms": 600000
      },
      {
        "name": "usage-cancel",
        "description": "Cancel a waiting included usage job",
        "effect": "write",
        "output": "json",
        "args": [{ "name": "job", "type": "string", "label": "Queued job ID", "required": true, "positional": true }]
      },
      {
        "name": "docs-status",
        "description": "Verify cached official documentation coverage freshness and hashes",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "flag": "--agent",
            "type": "string",
            "label": "Agent adapter"
          }
        ],
        "timeout_ms": 120000
      },
      {
        "name": "docs-refresh",
        "description": "Download complete official agent documentation and retain last-good content on failure",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "flag": "--agent",
            "type": "string",
            "label": "Agent adapter"
          }
        ],
        "timeout_ms": 600000
      },
      {
        "name": "docs-ensure",
        "description": "Refresh missing or stale documentation automatically",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "flag": "--agent",
            "type": "string",
            "label": "Agent adapter"
          }
        ],
        "timeout_ms": 600000
      },
      {
        "name": "maintenance",
        "description": "Daemon maintenance: official documentation and integration surfaces, or the model catalog with --models",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "models",
            "flag": "--models",
            "type": "boolean",
            "label": "Refresh the model and benchmark catalog"
          }
        ],
        "timeout_ms": 600000
      },
      {
        "name": "setup",
        "description": "Configure supported agent instruction surfaces and daemon task placement",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "node",
            "flag": "--node",
            "type": "string",
            "label": "Maintenance mesh node"
          }
        ],
        "timeout_ms": 120000
      },
      {
        "name": "docs-sources",
        "description": "List approved official documentation sources",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "docs-read",
        "description": "Read integrity-checked cached official documentation",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "flag": "--agent",
            "type": "string",
            "label": "Agent"
          },
          {
            "name": "url",
            "flag": "--url",
            "type": "string",
            "label": "Url"
          }
        ]
      },
      {
        "name": "docs-search",
        "description": "Search downloaded official documentation",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "flag": "--agent",
            "type": "string",
            "label": "Agent"
          },
          {
            "name": "query",
            "flag": "--query",
            "type": "string",
            "required": true,
            "label": "Query"
          }
        ]
      },
      {
        "name": "upstream",
        "description": "Probe latest upstream harness versions and update availability",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "changelog",
        "description": "Inspect recent official changelog highlights for a selected agent",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "agent",
            "type": "string",
            "label": "Agent identifier",
            "required": false,
            "positional": true
          }
        ]
      },
      {
        "name": "adapter",
        "description": "Manage extensible harness adapter definitions (list, add, remove)",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "operation",
            "type": "string",
            "label": "list | add | remove",
            "required": true,
            "positional": true
          },
          {
            "name": "target",
            "type": "string",
            "label": "File path, spec JSON, or adapter ID",
            "required": false,
            "positional": true
          }
        ]
      },
      {
        "name": "quota",
        "description": "Inspect 5-hour rolling/weekly quotas, credit balances, and host RAM",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "node",
            "flag": "--node",
            "type": "string",
            "label": "Mesh node"
          }
        ]
      },
      {
        "name": "benchmarks",
        "description": "Sourced model pricing, coding index and leaderboard results, with pass rates measured on this machine",
        "effect": "read",
        "output": "json",
        "args": []
      },
      {
        "name": "route",
        "description": "Choose the harness for a task; with --execute, run it on its own branch and escalate on failure",
        "effect": "write",
        "output": "json",
        "timeout_ms": 600000,
        "args": [
          {
            "name": "task",
            "type": "string",
            "label": "Task description",
            "required": true,
            "positional": true
          },
          {
            "name": "execute",
            "flag": "--execute",
            "type": "boolean",
            "label": "Run the task on its own branch"
          },
          {
            "name": "gate",
            "flag": "--gate",
            "type": "boolean",
            "label": "Require the code-quality gate, escalating when it fails"
          },
          {
            "name": "jev",
            "flag": "--jev",
            "type": "boolean",
            "label": "Classify through the decision plugin"
          },
          {
            "name": "tier",
            "flag": "--tier",
            "type": "string",
            "label": "Gate tier: fast | full | remote"
          },
          { "name": "cwd", "flag": "--cwd", "type": "string", "label": "Explicit workspace on the selected node" },
          { "name": "node", "flag": "--node", "type": "string", "label": "Selected mesh node" },
          { "name": "allowUnknownAuth", "flag": "--allow-unknown-auth", "type": "boolean", "label": "Explicitly allow a runner without a login probe" },
          { "name": "background", "flag": "--background", "type": "boolean", "label": "Return the owned job and log for a long run" },
          { "name": "timeoutMs", "flag": "--timeout-ms", "type": "number", "label": "Remote wall-clock limit in milliseconds" }
        ]
      },
      {
        "name": "coordinate",
        "description": "Coordinate multi-agent specialized execution pipelines (pipeline, council, race)",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "task",
            "type": "string",
            "label": "Task description",
            "required": true,
            "positional": true
          },
          {
            "name": "mode",
            "flag": "--mode",
            "type": "string",
            "label": "pipeline | council | race"
          },
          {
            "name": "execute",
            "flag": "--execute",
            "type": "boolean",
            "label": "Run the agents; without this the plan is only reported"
          },
          {
            "name": "gate",
            "flag": "--gate",
            "type": "boolean",
            "label": "Require the code-quality gate"
          },
          {
            "name": "autoReview",
            "flag": "--auto-review",
            "type": "boolean",
            "label": "Add a cross-model code review"
          },
          {
            "name": "allowSameFamily",
            "flag": "--allow-same-family",
            "type": "boolean",
            "label": "Accept a Verifier from the Implementer's model family"
          },
          { "name": "cwd", "flag": "--cwd", "type": "string", "label": "Explicit workspace on the selected node" },
          { "name": "node", "flag": "--node", "type": "string", "label": "Selected mesh node" },
          { "name": "allowUnknownAuth", "flag": "--allow-unknown-auth", "type": "boolean", "label": "Explicitly allow a runner without a login probe" },
          { "name": "background", "flag": "--background", "type": "boolean", "label": "Return the owned job and log for a long run" },
          { "name": "timeoutMs", "flag": "--timeout-ms", "type": "number", "label": "Remote wall-clock limit in milliseconds" }
        ],
        "timeout_ms": 600000
      },
      {
        "name": "learn",
        "description": "Summarize run receipts into scorecards and quota walls; --emit writes proposals to memory",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "emit",
            "flag": "--emit",
            "type": "boolean",
            "label": "Write proposals through the memory owner"
          },
          { "name": "void", "flag": "--void", "type": "string", "label": "Comma-separated receipt ids to void" },
          { "name": "reason", "flag": "--reason", "type": "string", "label": "Why the receipts are void" }
        ]
      },
      {
        "name": "alerts",
        "description": "Send operator alerts for quota walls and usage over the threshold",
        "effect": "send",
        "output": "json",
        "args": [
          {
            "name": "action",
            "type": "string",
            "label": "check | test",
            "positional": true
          },
          {
            "name": "threshold",
            "flag": "--threshold",
            "type": "number",
            "label": "Usage percent that triggers an alert"
          },
          {
            "name": "dryRun",
            "flag": "--dry-run",
            "type": "boolean",
            "label": "Report without sending"
          }
        ]
      },
      {
        "name": "decompose",
        "description": "Decompose complex multi-step tasks into specialized Explorer, Architect, Implementer, and Verifier subagent stages",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "task",
            "type": "string",
            "label": "Task description",
            "required": true,
            "positional": true
          }
        ]
      },
      {
        "name": "orchestrate",
        "description": "Orchestrate multi-step tasks using subagent fan-out, one-way valve context compression, and cross-model verification",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "task",
            "type": "string",
            "label": "Task description",
            "required": true,
            "positional": true
          },
          {
            "name": "orchestrator",
            "flag": "--orchestrator",
            "type": "string",
            "label": "Active orchestrator harness (claude, codex, agy, hermes, cursor)"
          },
          {
            "name": "execute",
            "flag": "--execute",
            "type": "boolean",
            "label": "Execute live stages"
          },
          {
            "name": "autoReview",
            "flag": "--auto-review",
            "type": "boolean",
            "label": "Trigger adversarial code review upon completion"
          },
          {
            "name": "gate",
            "flag": "--gate",
            "type": "boolean",
            "label": "Require the code-quality gate"
          },
          {
            "name": "allowSameFamily",
            "flag": "--allow-same-family",
            "type": "boolean",
            "label": "Accept a Verifier from the Implementer's model family"
          }
        ],
        "timeout_ms": 600000
      },
      {
        "name": "threads",
        "description": "Manage multi-platform agent threads, PR branch tracking, and turn history across all connected platforms",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "action",
            "type": "string",
            "label": "list | show | create | update | close | delete",
            "required": true,
            "positional": true
          },
          {
            "name": "target",
            "type": "string",
            "label": "Thread ID or title",
            "positional": true
          },
          { "name": "title", "flag": "--title", "type": "string", "label": "Thread title" },
          { "name": "summary", "flag": "--summary", "type": "string", "label": "Thread summary" },
          { "name": "status", "flag": "--status", "type": "string", "label": "Lifecycle status or list filter" },
          { "name": "platform", "flag": "--platform", "type": "string", "label": "Harness platform or list filter" },
          { "name": "branch", "flag": "--branch", "type": "string", "label": "Deliverable branch" }
        ]
      },
      {
        "name": "process",
        "description": "Manage owned agent processes through isolated dispatch and SSSS lifecycle records",
        "effect": "write",
        "output": "json",
        "timeout_ms": 600000,
        "args": [
          { "name": "action", "type": "string", "positional": true, "label": "list | status | spawn | kill | logs" },
          { "name": "target", "type": "string", "positional": true, "label": "Harness to spawn or managed process ID" },
          { "name": "task", "type": "string", "positional": true, "label": "Task for a spawned agent" },
          { "name": "node", "type": "string", "flag": "--node", "label": "Recorded mesh node" },
          { "name": "cwd", "type": "string", "flag": "--cwd", "label": "Explicit workspace on the selected node" },
          { "name": "name", "type": "string", "flag": "--name", "label": "Managed process label" },
          { "name": "tools", "type": "string", "flag": "--tools", "label": "Supported tool restriction" },
          { "name": "settingSources", "type": "string", "flag": "--setting-sources", "label": "Supported instruction setting sources" },
          { "name": "model", "type": "string", "flag": "--model", "label": "Explicit configured model selection" },
          { "name": "tail", "type": "number", "flag": "--tail", "label": "Log tail line count" },
          { "name": "readOnly", "type": "boolean", "flag": "--read-only", "label": "Disable code writes" },
          { "name": "noDetach", "type": "boolean", "flag": "--no-detach", "label": "Await the managed process result" },
          { "name": "allowUnknownAuth", "type": "boolean", "flag": "--allow-unknown-auth", "label": "Explicitly allow an unknown login state" }
        ]
      },
      {
        "name": "review",
        "description": "Execute automated adversarial cross-model code review on Git diffs, PR branches, or staged changes",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "target",
            "type": "string",
            "label": "Target branch, PR commit, or empty for working-tree",
            "positional": true
          },
          {
            "name": "reviewer",
            "flag": "--reviewer",
            "type": "string",
            "label": "Adversarial reviewer harness"
          },
          {
            "name": "staged",
            "flag": "--staged",
            "type": "boolean",
            "label": "Review staged diffs"
          },
          {
            "name": "author",
            "flag": "--author",
            "type": "string",
            "label": "Harness that wrote the code, excluded with its model family"
          },
          {
            "name": "thread",
            "flag": "--thread",
            "type": "string",
            "label": "Thread to attach the review to"
          },
          { "name": "cwd", "flag": "--cwd", "type": "string", "label": "Explicit workspace on the selected node" },
          { "name": "node", "flag": "--node", "type": "string", "label": "Selected mesh node" },
          { "name": "allowUnknownAuth", "flag": "--allow-unknown-auth", "type": "boolean", "label": "Explicitly allow a runner without a login probe" },
          { "name": "timeoutMs", "flag": "--timeout-ms", "type": "number", "label": "Remote wall-clock limit in milliseconds" }
        ],
        "timeout_ms": 600000
      }
    ]
  },
  "runtime": {
    "modules": {
      "command-executor": "src/executor.mjs",
      "documentation": "src/documentation.mjs",
      "agent-runtime": "src/runtime.mjs",
      "tracker": "src/tracker.mjs",
      "harness-compat": "src/compat-harness.mjs",
      "reasoning-runtime": "src/reasoning.mjs",
      "process-manager": "src/process-manager.mjs",
      "gate-adapters": "src/gate-adapters/index.mjs"
    },
    "setup_command": "setup"
  },
  "branding": {
    "name": "Metaharness",
    "color": "#3b82f6",
    "accent": "#38bdf8",
    "background": "#0c1427",
    "font": "system"
  },
  "ui": {
    "home": "home",
    "design_tokens": "DESIGN.md",
    "elements": [
      {
        "id": "home",
        "kind": "panel",
        "tag": "tr-metaharness-home",
        "module": "ui/home.js",
        "description": "Default Chat harness and launch destination"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "distribution": {
    "tier": "official",
    "license": "open"
  },
  "tasks": [
    {
      "intent": "Keep official agent documentation and Total Recall integrations current",
      "schedule": "*/15 * * * *",
      "command": "maintenance",
      "placement": "selected-node",
      "timeout_ms": 600000
    },
    {
