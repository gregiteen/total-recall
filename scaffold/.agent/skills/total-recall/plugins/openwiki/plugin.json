{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "openwiki",
  "name": "OpenWiki",
  "version": "0.1.2",
  "description": "Multi-repo knowledge graph and documentation wiki engine for Total Recall.",
  "license": "MIT",
  "branding": {
    "name": "OpenWiki",
    "color": "#b45309",
    "badge": "Knowledge Graph",
    "font": "newsreader"
  },
  "card_face": {
    "headline": "OpenWiki Control Deck",
    "quick_actions": [
      {
        "subcommand": "status",
        "label": "STATUS"
      },
      {
        "subcommand": "hubs",
        "label": "HUBS"
      },
      {
        "subcommand": "ingest",
        "label": "INGEST"
      },
      {
        "subcommand": "probe",
        "label": "200 PROBE"
      }
    ],
    "touch_layout": "comfortable",
    "interactive": true
  },
  "ssss_schemas": {
    "categories": [
      {
        "name": "openwiki-hubs",
        "description": "Multi-repo openwiki documentation and knowledge graph hubs",
        "node_type": "memory"
      },
      {
        "name": "openwiki-articles",
        "description": "Ingested openwiki documentation pages and architecture summaries",
        "node_type": "memory"
      }
    ]
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "cli": {
    "command": "openwiki",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "status",
        "description": "Show which OpenWiki subcommands are implemented",
        "effect": "read"
      },
      {
        "name": "hubs",
        "description": "List indexed OpenWiki hubs and page counts",
        "effect": "read"
      },
      {
        "name": "ingest",
        "description": "Ingest markdown documentation into the semantic knowledge graph",
        "timeout_ms": 600000,
        "effect": "write"
      },
      {
        "name": "bootstrap",
        "description": "Create missing OpenWiki documentation pages in explicit brain and project directories",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "brain",
            "flag": "--brain",
            "label": "Brain directory",
            "type": "string",
            "required": true
          },
          {
            "name": "projectRoot",
            "flag": "--project-root",
            "label": "Project root",
            "type": "string"
          },
          {
            "name": "dryRun",
            "flag": "--dry-run",
            "label": "Preview without writing",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "probe",
        "description": "Run HTTP 200 health verification probe",
        "effect": "read"
      }
    ]
  },
  "ui": {
    "design_tokens": "ui/DESIGN.md",
    "elements": [
      {
        "id": "panel",
        "kind": "panel",
        "tag": "openwiki-panel",
        "module": "ui/panel.js",
        "description": "OpenWiki panel",
        "events": [
          "save-token"
        ],
        "tokens": [
          "color-text",
          "color-surface",
          "color-border",
          "spacing-md",
          "radius-md"
        ],
        "optional_tokens": []
      },
      {
        "id": "card",
        "kind": "card",
        "tag": "tr-openwiki-card",
        "module": "ui/card.js",
        "description": "Knowledge Graph Card Face"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "status": {
    "command": "status",
    "refresh_seconds": 300
  }
}
