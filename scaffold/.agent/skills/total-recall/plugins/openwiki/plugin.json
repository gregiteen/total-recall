{
  "$schema": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "id": "openwiki",
  "name": "OpenWiki",
  "version": "0.1.7",
  "description": "Multi-repo knowledge graph and documentation wiki engine for Total Recall.",
  "license": "MIT",
  "runtime": {
    "modules": {
      "context-provider": "src/context-provider.mjs"
    }
  },
  "tasks": [
    {
      "intent": "Watch upstream OpenWiki repository and announce/propagate updates",
      "schedule": "0 */4 * * *",
      "command": "watch"
    },
    {
      "intent": "Auto-refresh OpenWiki documentation for repositories with new commits",
      "schedule": "*/30 * * * *",
      "command": "auto-refresh",
      "timeout_ms": 600000
    }
  ],
  "branding": {
    "name": "OpenWiki",
    "color": "#b45309",
    "badge": "Knowledge Graph",
    "font": "newsreader"
  },
  "secrets": [
    {
      "key": "OPENROUTER_API_KEY",
      "description": "Platform OpenRouter API key for cheap model documentation generation",
      "required": false
    },
    {
      "key": "GOOGLE_API_KEY",
      "description": "Platform Google Gemini API key for direct Gemini model documentation generation",
      "required": false
    }
  ],
  "card_face": {
    "headline": "OpenWiki Control Deck",
    "quick_actions": [
      {
        "subcommand": "status",
        "label": "STATUS"
      },
      {
        "subcommand": "hubs",
        "label": "HUBS"
      },
      {
        "subcommand": "ingest",
        "label": "INGEST"
      },
      {
        "subcommand": "probe",
        "label": "200 PROBE"
      }
    ],
    "touch_layout": "comfortable",
    "interactive": true
  },
  "ssss_schemas": {
    "categories": [
      {
        "name": "openwiki-hubs",
        "description": "Multi-repo openwiki documentation and knowledge graph hubs",
        "node_type": "memory"
      },
      {
        "name": "openwiki-articles",
        "description": "Ingested openwiki documentation pages and architecture summaries",
        "node_type": "memory"
      }
    ]
  },
  "deploy": {
    "targets": [
      "ssss-app",
      "nextjs",
      "react",
      "flask"
    ],
    "required_ssss_version": ">=0.9.3",
    "access_grants": [
      "auth:session:verify",
      "ssss:vault:read",
      "ssss:vault:write",
      "ssss:events:append"
    ]
  },
  "cli": {
    "command": "openwiki",
    "handler": "./cli.mjs",
    "subcommands": [
      {
        "name": "context",
        "description": "Retrieve task-relevant wiki and explicitly linked source evidence with provenance and freshness",
        "effect": "read",
        "output": "json",
        "args": [
          { "name": "task", "label": "Task description", "type": "string", "positional": true, "required": true },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "search",
        "description": "Search evidence passages in workspace, registered-vault or mesh documentation hubs",
        "effect": "read",
        "output": "json",
        "args": [
          { "name": "query", "label": "Search terms", "type": "string", "positional": true, "required": true },
          { "name": "allVaults", "label": "Search all registered vaults", "type": "boolean", "flag": "--all-vaults" },
          { "name": "node", "label": "Mesh node", "type": "string", "flag": "--node" },
          { "name": "limit", "label": "Maximum results", "type": "number", "flag": "--limit" },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "graph",
        "description": "Extract documentation link topology as JSON, Mermaid or DOT",
        "effect": "read",
        "output": "json",
        "args": [
          { "name": "allVaults", "label": "Inspect all registered vaults", "type": "boolean", "flag": "--all-vaults" },
          { "name": "node", "label": "Mesh node", "type": "string", "flag": "--node" },
          { "name": "format", "label": "Graph format", "type": "choice", "options": ["json", "mermaid", "dot"], "flag": "--format" },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "generate",
        "description": "Generate documentation for the selected registered repository or current workspace",
        "effect": "write",
        "output": "json",
        "timeout_ms": 600000,
        "args": [
          { "name": "repo", "label": "Registered repository", "type": "string", "flag": "--repo" },
          { "name": "node", "label": "Mesh node", "type": "string", "flag": "--node" },
          { "name": "force", "label": "Regenerate existing pages", "type": "boolean", "flag": "--force" },
          { "name": "dryRun", "label": "Describe generation without writing", "type": "boolean", "flag": "--dry-run" },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "token",
        "description": "Inspect provider credential status or save a provider key through the shared auth owner",
        "effect": "write",
        "output": "json",
        "args": [
          { "name": "action", "label": "Credential action", "type": "choice", "options": ["status", "set"], "positional": true },
          { "name": "provider", "label": "Credential provider", "type": "choice", "options": ["openrouter", "google"], "positional": true },
          { "name": "value", "label": "Secret value through stdin", "type": "string", "secret": true },
          { "name": "stdin", "label": "Read secret from stdin", "type": "boolean", "flag": "--stdin" },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "lint",
        "description": "Inspect documentation links and orphaned hubs without rewriting files",
        "effect": "read",
        "output": "json",
        "args": [
          { "name": "allVaults", "label": "Inspect all registered vaults", "type": "boolean", "flag": "--all-vaults" },
          { "name": "node", "label": "Mesh node", "type": "string", "flag": "--node" },
          { "name": "json", "label": "JSON output", "type": "boolean", "flag": "--json" }
        ]
      },
      {
        "name": "status",
        "description": "Show which OpenWiki subcommands are implemented",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "hubs",
        "description": "List indexed OpenWiki hubs and page counts",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "ingest",
        "description": "Ingest markdown documentation into the semantic knowledge graph",
        "timeout_ms": 600000,
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "path",
            "label": "OpenWiki path",
            "type": "string",
            "required": true,
            "positional": true
          },
          {
            "name": "dryRun",
            "flag": "--dry-run",
            "label": "Preview without writing",
            "type": "boolean"
          },
          {
            "name": "global",
            "flag": "--global",
            "label": "Target global brain",
            "type": "boolean"
          },
          {
            "name": "project",
            "flag": "--project",
            "label": "Target project brain",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "bootstrap",
        "description": "Create missing OpenWiki documentation pages in explicit brain and project directories",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "brain",
            "flag": "--brain",
            "label": "Brain directory",
            "type": "string",
            "required": true
          },
          {
            "name": "projectRoot",
            "flag": "--project-root",
            "label": "Project root",
            "type": "string"
          },
          {
            "name": "dryRun",
            "flag": "--dry-run",
            "label": "Preview without writing",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "probe",
        "description": "Run HTTP 200 health verification probe",
        "effect": "read",
        "output": "json",
        "args": [
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "refresh",
        "description": "Report which registered projects' generated OpenWiki pages are stale; --apply regenerates them (openwiki/ only)",
        "timeout_ms": 600000,
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "repo",
            "flag": "--repo",
            "label": "Target repository",
            "type": "string"
          },
          {
            "name": "apply",
            "flag": "--apply",
            "label": "Regenerate stale pages",
            "type": "boolean"
          },
          {
            "name": "force",
            "flag": "--force",
            "label": "Force regeneration",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "auto-refresh",
        "description": "Daemon automated check and regeneration for stale OpenWiki documentation across registered repositories",
        "timeout_ms": 600000,
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "repo",
            "flag": "--repo",
            "label": "Target repository",
            "type": "string"
          },
          {
            "name": "force",
            "flag": "--force",
            "label": "Force regeneration",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "watch",
        "description": "Watch upstream OpenWiki repository, announce new releases, and trigger propagation",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "checkOnly",
            "flag": "--check-only",
            "label": "Check without announcing or propagating",
            "type": "boolean"
          },
          {
            "name": "announce",
            "flag": "--announce",
            "label": "Dispatch operator announcement",
            "type": "boolean"
          },
          {
            "name": "propagate",
            "flag": "--propagate",
            "label": "Execute fleet propagation",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "propagate",
        "description": "Propagate updated OpenWiki generator across registered user repositories",
        "effect": "write",
        "output": "json",
        "timeout_ms": 600000,
        "args": [
          {
            "name": "repo",
            "flag": "--repo",
            "label": "Target repository",
            "type": "string"
          },
          {
            "name": "force",
            "flag": "--force",
            "label": "Force regeneration",
            "type": "boolean"
          },
          {
            "name": "dryRun",
            "flag": "--dry-run",
            "label": "Preview without writing",
            "type": "boolean"
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      },
      {
        "name": "config",
        "description": "Configure OpenWiki generator model routing, token bounds, and timeout",
        "effect": "write",
        "output": "json",
        "args": [
          {
            "name": "action",
            "label": "Action verb (show, get, set, reset)",
            "type": "string",
            "positional": true
          },
          {
            "name": "key",
            "label": "Configuration key",
            "type": "string",
            "positional": true
          },
          {
            "name": "value",
            "label": "Configuration value",
            "type": "string",
            "positional": true
          },
          {
            "name": "json",
            "flag": "--json",
            "label": "JSON output",
            "type": "boolean"
          }
        ]
      }
    ]
  },
  "ui": {
    "design_tokens": "ui/DESIGN.md",
    "elements": [
      {
        "id": "panel",
        "kind": "panel",
        "tag": "openwiki-panel",
        "module": "ui/panel.js",
        "description": "OpenWiki panel",
        "events": [
          "save-token"
        ],
        "tokens": [
          "color-text",
          "color-surface",
          "color-border",
          "spacing-md",
          "radius-md"
        ],
        "optional_tokens": []
      },
      {
        "id": "card",
        "kind": "card",
        "tag": "tr-openwiki-card",
        "module": "ui/card.js",
        "description": "Knowledge Graph Card Face"
      }
    ]
  },
  "auth": {
    "plugin": "auth",
    "methods": [
      "passkey",
      "google-oauth2"
    ],
    "session_verification": true
  },
  "capability": {
    "entry": "capability/index.mjs",
    "description": "Standalone documentation hub discovery, wiki page auditing, and knowledge structure bootstrapping",
    "dependencies": [],
    "exports": [
      "discoverWikiHubs",
      "parseWikiHub",
      "inspectWikiStaleness",
      "bootstrapWikiPages",
      "compareSemanticVersions",
      "createPropagationPlan",
      "formatPropagationReceipt"
    ]
  },
  "status": {
    "command": "status",
    "refresh_seconds": 300
  }
}
