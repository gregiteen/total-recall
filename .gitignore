node_modules/
*.db
*.db-wal
*.db-shm
.DS_Store

# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.key
*.pem

# Total Recall runtime — never commit
# The meta-skill (.agent/skills/total-recall/) IS the user's brain.
# All user data directories live inside it.
#
# Ignore the brain specifically, NOT all of .agent/skills/. The sibling
# directories there are repo-scoped dev skills (security, code-quality, push,
# repo-expert…) — authored repo knowledge that belongs in version control and
# must survive a fresh clone. A blanket .agent/skills/ rule swept those up with
# the user data, so every dev skill lived only on the machine that wrote it.
.agent/skills/total-recall/
.agent/memory-vault/
.agent/memory-derived/
.agent/memory-inbox/
.agent/scheduler/
.agent/config/
.agent/files/
.agent/logs/
.agent/.backups/
# `skill generate-expert` snapshots the previous SKILL.md beside it on every
# run. Those snapshots are local scratch and carry the generating machine's
# paths, so they must never be committed.
.agent/skills/*/SKILL.md.backup-*
.agent/memory/episodes/
.agent/memory/daily-logs/
.agent/memory-pipeline-errors.log
.agent/sessions/
.agent/interrupts/

# Guard against test-mock gaps leaking real writes to repo root instead of
# the real brainDir (~/.agent/skills/total-recall/) — see obsidian-sync.spec.mjs
/brain/

# Daemon / checker runtime state
.remember/
.last-successful-ts.txt
.last-successful-lint.txt
*.checker.log
.typescript-checker.status
# PID files of the running checkers. Absent from this list until 2026-08-01
# only because the TS checker crashed on every pass and its exit handler
# removed the file — a long-lived daemon leaves one behind.
typescript-checker.pid
lint-checker.pid
.agent/skills/code-quality/scripts/*.log
.agent/skills/mcp-expert/.watch-state.json
lint-status.txt
typescript-fullrepo-errors.txt
frontend/.eslintcache

# Secrets stores and their backups — never committed. The repo root carries a
# legacy flat .agent/secrets.enc, and repair scripts leave *.bak-* copies beside
# it; a blanket `git add -A` would have published one of them.
.agent/secrets.enc
.agent/secrets.enc.bak-*
# Research queue/agenda state at the repo's .agent root — runtime data, the same
# class as .agent/scheduler/.
.agent/research-queue.jsonl

# Dev skills (Greg's personal workflow tools — not part of the product)
.agent/dev-skills/

# Personal .agent/ identity and user data — generated at runtime, never ship
.agent/USER.md
.agent/SOUL.md
.agent/IDENTITY.md

# Compiled agent rule files — generated by 'npx total-recall compile' from
# the user's local vault. Blank stubs exist in repo; local versions are personal.
.agent/AGENTS.md
.agent/CLAUDE.md
.agent/GEMINI.md
.agent/INSTRUCTIONS.md
.agent/.clauderules
.agent/.cursorrules
.agent/CODEX.md
.agent/.codexrules

# Personal workspace projections at repo root
# These are IDE shims compiled for Greg's local setup — not product files.
# The canonical versions live in .agent/ and ship via the files whitelist.
INSTRUCTIONS.md
AGENTS.md
CLAUDE.md
GEMINI.md
HANDOFF.md
.clauderules
.cursorrules
CODEX.md
.codexrules
claude_help.txt
gemini_help.txt
manual-test-agent.mjs

# Claude Code slash commands (personal, IDE-generated)
.claude/commands/

# Build artifacts
dist/
build/
*.js.map

# Security: certificate/key files
*.pem
*.key
*.p12
*.pfx

# Scratch folder and local secrets
scratch/
.agent/secrets.enc

server.log
.npmrc.publish

# `push/` was ignored here because its content was UltraChat's — a production
# droplet IP with root SSH deploy commands — and this repo is public. It is now
# written for Total Recall (it documents the real pull-based deploy in
# scripts/auto-pull.sh), so it is tracked like every other repo-scoped skill.
# `instruction-keeper/` was an UltraChat stub pointing at an absolute /Users/...
# path in another product's repo; it has been deleted outright.

# Generated per machine by `total-recall init` / `compile` / `connect` — never committed here
.gemini/commands/
.agent/commands/
openwiki/
.windsurfrules
WINDSURF.md
.cursor/rules/
.vscode/copilot-instructions.md
.claude/worktrees/
