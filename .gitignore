node_modules/
*.tgz
*.db
*.db-wal
*.db-shm
.DS_Store
.data/

# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.key
*.pem

# Total Recall runtime — never commit
# The meta-skill (.agent/skills/total-recall/) IS the user's brain.
# All user data directories live inside it.
#
.agent/skills/total-recall/
.agent/memory-vault/
.agent/memory-derived/
.agent/memory-inbox/
.agent/scheduler/
.agent/config/
.agent/files/
.agent/logs/
.agent/.backups/
# `skill generate-expert` snapshots the previous SKILL.md beside it on every
# run. Those snapshots are local scratch and carry the generating machine's
# paths, so they must never be committed.
.agent/skills/*/SKILL.md.backup-*
.agent/memory/episodes/
.agent/memory/daily-logs/
.agent/memory-pipeline-errors.log
.agent/sessions/
.agent/interrupts/

# Guard against test-mock gaps leaking real writes to repo root instead of
# the real brainDir (~/.agent/skills/total-recall/) — see obsidian-sync.spec.mjs
/brain/

# Daemon / checker runtime state
.remember/
.last-successful-ts.txt
.last-successful-lint.txt
*.checker.log
.typescript-checker.status
# PID files of the running checkers. Absent from this list until 2026-08-01
# only because the TS checker crashed on every pass and its exit handler
# removed the file — a long-lived daemon leaves one behind.
typescript-checker.pid
lint-checker.pid
.agent/skills/code-quality/scripts/*.log
.agent/skills/mcp-expert/.watch-state.json
lint-status.txt
typescript-fullrepo-errors.txt
frontend/.eslintcache

# Secrets stores and their backups — never committed. The repo root carries a
# legacy flat .agent/secrets.enc, and repair scripts leave *.bak-* copies beside
# it; a blanket `git add -A` would have published one of them.
.agent/secrets.enc
.agent/secrets.enc.bak-*
# Research queue/agenda state at the repo's .agent root — runtime data, the same
# class as .agent/scheduler/.
.agent/research-queue.jsonl

# Dev skills (local workflow tools, not part of the product)
.agent/dev-skills/

# Personal .agent/ identity and user data — generated at runtime, never ship
.agent/USER.md
.agent/SOUL.md
.agent/IDENTITY.md

# Compiled agent rule files — generated by 'npx total-recall compile' from
# the user's local vault. Blank stubs exist in repo; local versions are personal.
.agent/AGENTS.md
.agent/CLAUDE.md
.agent/GEMINI.md
.agent/INSTRUCTIONS.md
.agent/.clauderules
.agent/.cursorrules
.agent/CODEX.md
.agent/.codexrules

# Personal workspace projections at repo root
# IDE shims compiled per machine, not product files.
# The canonical versions live in .agent/ and ship via the files whitelist.
INSTRUCTIONS.md
AGENTS.md
CLAUDE.md
GEMINI.md
# The owner-requested root project handoff is tracked; private session exports stay local.
.clauderules
.cursorrules
CODEX.md
.codexrules
claude_help.txt
gemini_help.txt
manual-test-agent.mjs

# Claude Code slash commands (personal, IDE-generated)
.claude/commands/

# Build artifacts
dist/
build/
*.js.map

# Security: certificate/key files
*.pem
*.key
*.p12
*.pfx

# Scratch folder and local secrets
scratch/
.agent/secrets.enc

server.log
.npmrc.publish

# Generated per machine by `total-recall init` / `compile` / `connect` — never committed here
.gemini/commands/
.agent/commands/
/openwiki/
.windsurfrules
WINDSURF.md
.cursor/rules/
.vscode/copilot-instructions.md
.claude/worktrees/

# Per-run fixtures that specs must import through Vite (it only loads fresh
# modules from inside the project root). Removed by each spec after use.
.vitest-tmp/

# Open-source hygiene: the canonical repo carries NO user memories, IDE
# projections or private session handoffs. Those belong to each user's installation
# (a machine may have any of them locally; none are committed).
# `.agent/*` rather than `.agent/`: git does not descend into an ignored
# directory, so a plain `.agent/` would make every `!` re-include below dead.
.agent/*
# The scaffold is what new projects and git-updated hosts start from; its bundled plugins (auth is required) must be in git.
!/scaffold/.agent/
# Skills live in a private repository, not here. The one exception is the gate
# config, which the code-quality plugin reads from this fixed path.
!.agent/skills/
.agent/skills/*
!.agent/skills/code-quality/
.agent/skills/code-quality/sessions/
.agent/skills/code-quality/.check.lock
.agents/
.claude/
.codex/
.cursor/
.windsurf/
.hermes/
# The owner-requested root project handoff is tracked; private session exports stay local.
.deploy-state.json

# Internal project records live in a private repository, cloned here
docs/projects/

# Plugin state written by commands run in this checkout (SSSS VFS). Private, never published.
/.ssss/

# Total Recall brain state (machine-local: holds a live PAT)
.agent/skills/total-recall/config/brain.json
.agent/skills/total-recall/config/brain.json.bak-*
.agent/skills/total-recall/config/keys.jsonl
.agent/skills/total-recall/config/secrets.enc
.agent/skills/total-recall/config/secrets.enc.bak-*
.agent/skills/total-recall/config/leader.json
.agent/skills/total-recall/*.pid
