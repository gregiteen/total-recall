*.pem
*.key
*.p12
*.pfx

# Scratch folder and local secrets
scratch/
.agent/secrets.enc

server.log
.npmrc.publish

# UltraChat-specific dev skills. This repo is PUBLIC and open-source, and TR's
# own invariant forbids naming third-party product repos in it.
#   push/              production droplet IP + root SSH deploy commands
#   instruction-keeper/ stub pointing at an absolute /Users/... UltraChat path
# They stay on disk for local use; they must not ship.
.agent/skills/push/
.agent/skills/instruction-keeper/
