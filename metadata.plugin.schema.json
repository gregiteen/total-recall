{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gregiteen/total-recall/blob/main/metadata.plugin.schema.json",
  "title": "Total Recall Plugin Manifest Schema",
  "description": "Schema for plugin.json manifests. Plugins customize Total Recall for a particular use and are shared peer to peer over the mesh. Only fields listed here are acted on by Total Recall.",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description"
  ],
  "additionalProperties": true,
  "properties": {
    "configuration": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "label",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "default": {},
              "options": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Unique plugin identifier in kebab-case, e.g. scientific-frontiers"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable name of the plugin"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic versioning (e.g. 1.0.0)"
    },
    "description": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500,
      "description": "Description of the plugin's capability and purpose"
    },
    "license": {
      "type": "string",
      "default": "MIT"
    },
    "cli": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "subcommands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "effect": {
                "enum": ["read", "write", "destructive", "send"]
              },
              "output": {
                "enum": ["json", "text"]
              },
              "timeout_ms": {
                "type": "integer", "minimum": 1, "maximum": 600000
              },
              "args": {
                "type": "array",
                "items": { "$ref": "#/definitions/cardArgument" }
              }
            }
          }
        }
      }
    },
    "compile": {
      "type": "object",
      "properties": {
        "generator": {
          "type": "string",
          "description": "Custom JS module implementing generateContext()"
        },
        "watch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "string"
        },
        "auto": {
          "type": "boolean"
        }
      }
    },
    "ssss_schemas": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "node_type": {
                "type": "string",
                "default": "memory"
              },
              "template": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Plugin CLI subcommands run on a schedule by the daemon, out of process. Each run is recorded as a plugin.task_run event.",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "schedule",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "intent": {
            "type": "string",
            "description": "What the task does, for humans"
          },
          "schedule": {
            "type": "string",
            "description": "5-field cron expression, local time"
          },
          "command": {
            "type": "string",
            "description": "Subcommand passed to the plugin CLI handler (requires cli.handler)"
          },
          "placement": {
            "enum": [
              "per-node",
              "selected-node"
            ],
            "description": "Default per-node; selected-node requires plugin_record.task_nodes[command] to match this mesh node"
          }
        }
      }
    },
    "author": {
      "type": "string",
      "description": "Who wrote the plugin"
    },
    "homepage": {
      "type": "string",
      "description": "Where the plugin source lives, if published"
    },
    "use_cases": {
      "type": "array",
      "description": "What the plugin is for, as kebab-case tags (e.g. software-development, research, operations). Used to filter plugin lists.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,47}$"
      },
      "uniqueItems": true
    },
    "openwiki_hubs": {
      "type": "array",
      "description": "Markdown hubs ingested into OpenWiki by `total-recall ingest-openwiki`",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "deploy": {
      "type": "object",
      "description": "Capability deployment contract for installing features into target hosts",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Supported target app environments (e.g. ssss-app, flask, nextjs, react)"
        },
        "required_ssss_version": {
          "type": "string",
          "description": "Minimum SSSS specification/kernel version required"
        },
        "access_grants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Required capability permissions (e.g. ssss:vault:read, ssss:events:append)"
        },
        "resources": {
          "type": "object",
          "description": "External resource bindings required by the capability"
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "Declared secrets and API keys required for authentication by this plugin",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,64}$",
            "description": "Environment variable or secret store key"
          },
          "description": {
            "type": "string",
            "description": "What this secret is used for"
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "Repo-adapted skills provided by this capability plugin",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "description": "CLI subcommands to auto-register in .agent/commands/",
      "items": {
        "type": "object",
        "required": [
          "name",
          "handler"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "handler": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "background": {
            "type": "boolean",
            "description": "Allow --background and write a private report log."
          }
        }
      }
    },
    "app_cli": {
      "type": "object",
      "description": "The app's own runtime CLI, generated per language by `total-recall app cli` (Node ESM or Python argparse). Runs without Total Recall and calls the app's HTTP API.",
      "required": [
        "name",
        "api",
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "description": {
          "type": "string"
        },
        "api": {
          "type": "object",
          "required": [
            "base_url_env",
            "default_base_url"
          ],
          "additionalProperties": false,
          "properties": {
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "description": "Environment variable that overrides the base URL"
            },
            "default_base_url": {
              "type": "string",
              "description": "http(s) loopback URL of the app API (127.0.0.1, localhost or [::1])"
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600,
              "default": 30
            }
          }
        },
        "auth": {
          "type": "object",
          "required": [
            "type",
            "token_env"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bearer"
            },
            "token_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "description": "Environment variable holding the token; never stored in the generated file"
            }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "method",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "description": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9_\\-./{}]*$",
                "description": "Path under the base URL; {name} placeholders are filled from required args, the rest go to the query (GET/DELETE) or JSON body"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$",
                      "not": {
                        "enum": [
                          "json",
                          "base_url",
                          "help",
                          "command"
                        ]
                      }
                    },
                    "type": {
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "positional": {
                      "type": "boolean"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 1
                    },
                    "default": {}
                  }
                }
              }
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "UI elements: self-contained custom elements styled only by design-token CSS variables. `total-recall app ui` generates a web-component build (Flask/Jinja, any HTML host) or React/Next wrappers, plus tokens.css from the app's DESIGN.md.",
      "additionalProperties": false,
      "properties": {
        "design_tokens": {
          "type": "string",
          "pattern": "\\.md$",
          "description": "Plugin-relative default DESIGN.md, used when the app supplies none."
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "tag",
              "module"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "kind": {
                "enum": [
                  "panel",
                  "form",
                  "list",
                  "detail",
                  "settings",
                  "widget",
                  "card",
                  "card-face"
                ]
              },
              "tag": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)+$",
                "description": "Custom element name the module defines, exactly once."
              },
              "module": {
                "type": "string",
                "pattern": "\\.m?js$",
                "description": "Plugin-relative ES module with no imports."
              },
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "description": {
                "type": "string"
              },
              "props": {
                "type": "object",
                "description": "Properties the host sets on the element (camelCase; the React wrapper sets them as DOM properties).",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "boolean",
                        "object",
                        "array"
                      ]
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "events": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "tokens": {
                "type": "array",
                "uniqueItems": true,
                "description": "CSS variables (without --) the element needs; the app's DESIGN.md must define them.",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,127}$"
                }
              },
              "optional_tokens": {
                "type": "array",
                "uniqueItems": true,
                "description": "CSS variables the element uses with a var() fallback to another token.",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,127}$"
                }
              }
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "description": "Customizable branding and icon metadata for showcase and store presentation",
      "properties": {
        "name": {
          "type": "string",
          "description": "Distinctive brand name"
        },
        "wordmark": {
          "type": "string",
          "description": "Custom typographic wordmark logo"
        },
        "icon": {
          "type": "string",
          "description": "DEPRECATED: an emoji or generic icon. Show the real vector logo with 'logo' instead."
        },
        "logo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.(svg|png)$",
          "description": "Relative path inside the plugin to its real logo mark (.svg or .png)"
        },
        "font": {
          "type": "string",
          "enum": [
            "system",
            "inter",
            "ibm-plex",
            "space-grotesk",
            "jetbrains-mono",
            "dm-sans",
            "outfit",
            "fraunces",
            "newsreader",
            "chivo-mono"
          ],
          "description": "Canonical brand font token; a raw CSS font stack is rejected with a warning"
        },
        "color": {
          "type": "string",
          "description": "Primary brand color hex (e.g. #10b981, #3b82f6)"
        },
        "background": {
          "type": "string",
          "description": "Dark surface or background color hex"
        },
        "accent": {
          "type": "string",
          "description": "Secondary accent or glow color hex"
        },
        "image": {
          "type": "string",
          "description": "Image URL or data URI for branding presentation"
        },
        "badge": {
          "type": "string",
          "description": "Custom status or badge text"
        }
      }
    },
    "card_face": {
      "type": "object",
      "description": "Branded creative UI card face configuration: mobile-first, touch-friendly, agent-customizable layout, metrics, and actions",
      "properties": {
        "skin": {
          "type": "string",
          "enum": [
            "winamp-classic",
            "analog-hifi",
            "synth-deck",
            "translucent-acrylic",
            "pocket-arcade",
            "studio-rack",
            "vibrant-modern"
          ],
          "description": "Creative visual skin inspired by classic audio players, hardware decks, and retro UI"
        },
        "theme": {
          "type": "string",
          "enum": [
            "vibrant",
            "neon",
            "gradient",
            "minimal",
            "glass",
            "compact"
          ],
          "description": "Visual theme preset for the card face"
        },
        "headline": {
          "type": "string",
          "description": "Custom headline or tag line for the plugin card face"
        },
        "primary_color": {
          "type": "string",
          "description": "Primary brand color hex (e.g. #10b981)"
        },
        "secondary_color": {
          "type": "string",
          "description": "Secondary accent or background tint hex"
        },
        "accent_color": {
          "type": "string",
          "description": "Highlight or glowing accent hex"
        },
        "quick_actions": {
          "type": "array",
          "description": "Touch-friendly direct CLI execution actions rendered on the card face",
          "items": {
            "type": "object",
            "required": [
              "subcommand",
              "label"
            ],
            "properties": {
              "subcommand": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "description": "DEPRECATED: fixed text cannot reflect real state. Declare a 'status' command (top-level 'status' field) so the card reads the plugin's real state instead.",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "touch_layout": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable",
            "dense"
          ],
          "description": "Touch target and padding layout mode"
        },
        "interactive": {
          "type": "boolean",
          "description": "Whether interactive JavaScript controls are active on the card face"
        }
      }
    },
    "locked": {
      "type": "boolean",
      "description": "When true, editing is locked to protect a completed plugin from inadvertent modification"
    },
    "monetization": {
      "type": "object",
      "description": "Creator monetization contract: pricing tier, license enforcement, and payment models.",
      "required": [
        "model"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "free",
            "one-time",
            "subscription",
            "metered",
            "take-rate"
          ],
          "description": "Monetization tier model"
        },
        "price_cents": {
          "type": "integer",
          "minimum": 0,
          "description": "Base price in cents (USD)"
        },
        "currency": {
          "type": "string",
          "pattern": "^[a-z]{3}$",
          "default": "usd",
          "description": "ISO currency code in lowercase"
        },
        "period": {
          "type": "string",
          "enum": [
            "monthly",
            "yearly",
            "per-use",
            "per-ticket"
          ],
          "description": "Billing period or metering unit"
        },
        "take_rate_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "description": "Platform or creator take-rate in basis points (e.g. 250 = 2.5%)"
        },
        "recipient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "stripe_account",
                "crypto_address",
                "mesh_identity"
              ]
            },
            "account_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "license_key_secret": {
          "type": "string",
          "pattern": "^[A-Z0-9_]{1,64}$",
          "description": "Total Recall secret store key holding the user's active license key"
        },
        "checkout_url": {
          "type": "string",
          "description": "Web URL or checkout link to purchase license or subscription"
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "routers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "refresh_seconds": { "type": "integer", "minimum": 5, "maximum": 86400 }
      }
    },
    "distribution": {
      "type": "object",
      "required": ["tier", "license"],
      "properties": {
        "tier": { "enum": ["core", "official", "personal", "community"] },
        "license": { "enum": ["open", "closed"] }
      }
    },
    "card_layout": {
      "type": "object",
      "required": ["template", "regions"],
      "properties": {
        "template": { "enum": ["console", "ledger", "monitor", "inbox", "dashboard", "workbench", "vault"] },
        "regions": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "required": ["widget"],
            "properties": {
              "widget": { "enum": ["status", "actions", "table", "detail", "log", "form", "keypad", "gauge", "list", "settings", "credentials", "activity", "live"] },
              "title": { "type": "string" },
              "command": { "type": "string" },
              "commands": { "type": "array", "items": { "type": "string" } },
              "span": { "type": "integer", "minimum": 1, "maximum": 12 },
              "source": {
                "type": "object", "required": ["command"],
                "properties": {
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "path": { "type": "string" }
                }
              },
              "columns": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "required": ["key", "label"],
                  "properties": {
                    "key": { "type": "string" }, "label": { "type": "string" },
                    "format": { "enum": ["text", "number", "money", "date", "datetime", "bytes", "percent", "status"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workspace": {
      "type": "object",
      "description": "Live-use surface hosted in the slide-out drawer",
      "properties": {
        "component": {
          "type": "string",
          "description": "Component identifier or path for the drawer workspace"
        },
        "tabs": {
          "type": "array",
          "description": "Workspace tab names",
          "items": {
            "type": "string"
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "description": "Host permissions required by the workspace (e.g. microphone)",
          "items": {
            "enum": ["microphone", "camera", "notifications"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "cardArgument": {
      "type": "object", "required": ["name", "label", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,63}$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "number", "boolean", "choice"] },
        "flag": { "type": "string", "pattern": "^--[a-z][a-z0-9-]{0,63}$" },
        "positional": { "type": "boolean" },
        "required": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "options": { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } }
      },
      "anyOf": [
        { "required": ["flag"] },
        { "required": ["positional"], "properties": { "positional": { "const": true } } },
        { "required": ["secret"], "properties": { "secret": { "const": true } } }
      ],
      "allOf": [{
        "if": { "required": ["secret"], "properties": { "secret": { "const": true } } },
        "then": { "not": { "required": ["flag"] }, "properties": { "type": { "const": "string" } } }
      }]
    }
  }
}
