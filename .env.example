# ─── Total Recall Environment Configuration ─────────────────────────────────
#
# Copy this file to .env and fill in the values you need.
# All variables are optional — Total Recall works fully offline with no config.
#
# For portability: your ~/.total-recall/config.mjs holds runtime settings.
# This .env is for secrets that shouldn't be in a JS config file.
# ──────────────────────────────────────────────────────────────────────────────

# ─── LLM API Keys (for direct API mode — no CLI agents needed) ───────────────
# If set, the pipeline can call LLM APIs directly instead of spawning CLI tools.
# Leave blank to use CLI agents (gemini, claude, codex) which handle their own auth.

# TOTAL_RECALL_OPENAI_KEY=sk-...
# TOTAL_RECALL_ANTHROPIC_KEY=sk-ant-...
# TOTAL_RECALL_GOOGLE_KEY=AIza...
# TOTAL_RECALL_OPENROUTER_KEY=sk-or-...

# ─── Notification Channels ───────────────────────────────────────────────────
# Enable by setting the relevant webhook/key. Channels without config are skipped.

# Slack incoming webhook URL
# TOTAL_RECALL_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../xxx

# Discord webhook URL
# TOTAL_RECALL_DISCORD_WEBHOOK=https://discord.com/api/webhooks/.../...

# Email notifications (via Resend)
# TOTAL_RECALL_RESEND_KEY=re_...
# TOTAL_RECALL_EMAIL_TO=you@example.com
# TOTAL_RECALL_EMAIL_FROM=memory@totalrecall.dev

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
# TOTAL_RECALL_VAPID_PUBLIC_KEY=...
# TOTAL_RECALL_VAPID_PRIVATE_KEY=...
# TOTAL_RECALL_VAPID_EMAIL=mailto:you@example.com

# ─── Cloud API (future — not yet implemented) ────────────────────────────────
# TOTAL_RECALL_API_KEY=tr_live_...
# TOTAL_RECALL_API_URL=https://api.totalrecall.dev
