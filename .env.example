# ─── Total Recall Environment Configuration ─────────────────────────────────
#
# Copy this file to .env and fill in the values you need.
# All variables are optional — Total Recall works fully offline with system defaults.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core Paths & Runtime Settings ────────────────────────────────────────────
# AGENT_DIR: Path to the local agent state and vault directory (default: ~/.agent)
# AGENT_DIR=~/.agent

# XDG_CONFIG_HOME: XDG config directory for local config overrides (default: ~/.config)
# XDG_CONFIG_HOME=~/.config

# NODE_ENV: Node execution environment (production, development, test)
# NODE_ENV=production

# PORT: Local REST API and web dashboard port (default: 3000)
# PORT=3000

# HOST: Local REST API bound host (default: 127.0.0.1)
# HOST=127.0.0.1

# DISPLAY: X11 display environment variable (used by Playwright / Xvfb)
# DISPLAY=:99

# ─── LLM & Embedding Settings ─────────────────────────────────────────────────
# OLLAMA_URL: Local Ollama URL (default: http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434

# OLLAMA_ENDPOINT: Custom Ollama chat/generation endpoint path (optional)
# OLLAMA_ENDPOINT=

# OLLAMA_MODEL: Primary LLM model for the local kernel (default: gemma4:26b)
# OLLAMA_MODEL=gemma4:26b

# TR_EMBED_MODEL: Embedding model for local semantic indexing (default: nomic-embed-text)
# TR_EMBED_MODEL=nomic-embed-text

# ─── Auth & Session Management ───────────────────────────────────────────────
# SESSION_SECRET: Express session cookie secret
# SESSION_SECRET=change-this-to-a-secure-random-key

# TOTAL_RECALL_TOKEN: Global bearer auth token for Total Recall CLI & server sync
# TOTAL_RECALL_TOKEN=

# TR_BRAIN: Target brain endpoint url for command sync
# TR_BRAIN=

# TR_PAT: Personal access token (PAT) for brain authentication
# TR_PAT=

# ─── External Search & Fact-Seeking APIs ──────────────────────────────────────
# SEARXNG_BASE_URL: Base URL for a private SearXNG search instance
# SEARXNG_BASE_URL=

# BRAVE_API_KEY: General Brave API key for web search queries
# BRAVE_API_KEY=

# BRAVE_SEARCH_API_KEY: Dedicated Brave Search API key (alternative)
# BRAVE_SEARCH_API_KEY=

# EXA_API_KEY: Exa.ai search and neural retrieval API key
# EXA_API_KEY=

# GITHUB_TOKEN: GitHub PAT for repository backups and issue tracking
# GITHUB_TOKEN=

# SERPER_API_KEY: Google Search API key via Serper.dev
# SERPER_API_KEY=

# TAVILY_API_KEY: Tavily Search API key for agentic web search
# TAVILY_API_KEY=

# TR_DAILY_SEARCH_LIMIT: Daily cap on total external search queries (default: 50)
# TR_DAILY_SEARCH_LIMIT=50

# RESEARCH_COOLDOWN_MS: Cooldown interval between parallel research tasks in ms (default: 3600000)
# RESEARCH_COOLDOWN_MS=3600000
