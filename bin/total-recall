#!/usr/bin/env node
/**
 * total-recall — CLI entry point
 *
 * Usage:
 *   total-recall init                      Scaffold .agent/ directory
 *   total-recall search "term"             FTS5 full-text search (BM25 ranked)
 *   total-recall search "term" --source X  Filter by source type
 *   total-recall graph "slug"              Knowledge graph traversal
 *   total-recall steer --type never "..."  Immediate behavioral cascade
 *   total-recall note --category TYPE "..."  Log note with full cascade
 *   total-recall reindex                   Rebuild FTS5 from filesystem
 *   total-recall compile-surface           Regenerate DISTILLED MEMORY
 *   total-recall lint                      Wiki integrity check
 *   total-recall dream                     Run consolidation cycle
 *   total-recall stats                     Memory system health report
 *   total-recall notify "title" "msg"      Enqueue notification
 *   total-recall notify --list             List pending notifications
 *   total-recall notify --drain            Drain and display all queued
 */

import path from 'path';
import os from 'os';
import fs from 'fs';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = process.cwd();

const command = process.argv[2];
const args = process.argv.slice(3);

async function main() {
  const { loadConfig, resolvePaths } = await import('../src/core/utils.mjs');
  const config = await loadConfig(ROOT);
  const paths = resolvePaths(ROOT, config);

  switch (command) {
    case 'install':
      await runInstall(paths, config);
      break;

    case 'init':
      await runInit(paths, config);
      break;

    case 'uninstall':
      await runUninstall(paths, config);
      break;

    case 'search':
      await runSearch(paths, args);
      break;

    case 'graph':
      await runGraph(paths, args);
      break;

    case 'steer':
      await runSteer(paths, config, args);
      break;

    case 'note':
      await runNote(paths, config, args);
      break;

    case 'reindex':
      await runReindex(paths);
      break;

    case 'compile-surface':
      await runCompileSurface(paths, config);
      break;

    case 'lint':
      await runLint(paths);
      break;

    case 'dream':
      await runDream(paths);
      break;

    case 'stats':
      await runStats(paths);
      break;

    case 'notify':
      await runNotify(args);
      break;

    case 'setup':
      await runSetup(args);
      break;

    case 'status':
      await runStatus(paths);
      break;

    case 'heartbeat':
      await runHeartbeatCmd(paths, config);
      break;

    case 'sync-prompts':
      // Delegate to the sync-prompts module (it handles its own args)
      await import('../src/core/sync-prompts.mjs');
      break;

    default:
      printUsage();
      break;
  }
}

// ─── INSTALL ────────────────────────────────────────────────────────────────────

async function runInstall(paths, config) {
  const GLOBAL_DIR = path.join(os.homedir(), '.total-recall');
  const GLOBAL_CONFIG = path.join(GLOBAL_DIR, 'config.mjs');

  // --list: show all registered repos
  if (args.includes('--list')) {
    const repos = await loadGlobalRepos(GLOBAL_CONFIG);
    if (repos.length === 0) {
      console.log('No repos registered. Run `total-recall install` inside a repo to register it.');
      return;
    }
    console.log(`\n📂 Registered Repos (${repos.length})\n`);
    for (const repo of repos) {
      const expanded = repo.replace(/^~/, os.homedir());
      const exists = fs.existsSync(expanded);
      const hasAgent = fs.existsSync(path.join(expanded, '.agent'));
      const status = !exists ? '❌ missing' : hasAgent ? '🟢 initialized' : '🟡 not initialized';
      console.log(`  ${status}  ${repo}`);
    }
    console.log('');
    return;
  }

  // Resolve which repo to install
  const targetRepo = args[0] || ROOT;
  const absRepo = path.resolve(targetRepo);
  const tildeRepo = absRepo.replace(os.homedir(), '~');

  // --remove: unregister a repo
  if (args.includes('--remove')) {
    const repos = await loadGlobalRepos(GLOBAL_CONFIG);
    const filtered = repos.filter(r => {
      const expanded = r.replace(/^~/, os.homedir());
      return expanded !== absRepo;
    });
    if (filtered.length === repos.length) {
      console.log(`⚠️  "${tildeRepo}" is not registered.`);
      return;
    }
    await writeGlobalRepos(GLOBAL_CONFIG, filtered);
    console.log(`🗑️  Removed "${tildeRepo}" from registry. (${filtered.length} repos remaining)`);
    return;
  }

  // Validate it's a real directory
  if (!fs.existsSync(absRepo)) {
    console.log(`❌ Directory not found: ${absRepo}`);
    process.exit(1);
  }

  // Register in global config
  fs.mkdirSync(GLOBAL_DIR, { recursive: true });
  const repos = await loadGlobalRepos(GLOBAL_CONFIG);
  const alreadyRegistered = repos.some(r => r.replace(/^~/, os.homedir()) === absRepo);

  if (alreadyRegistered) {
    console.log(`✅ "${tildeRepo}" is already registered.`);
  } else {
    repos.push(tildeRepo);
    await writeGlobalRepos(GLOBAL_CONFIG, repos);
    console.log(`📌 Registered "${tildeRepo}" (${repos.length} repos total)`);
  }

  // Auto-init if not already initialized
  const hasAgent = fs.existsSync(path.join(absRepo, '.agent'));
  if (!hasAgent) {
    console.log('\n🔧 Repo not initialized — running init...\n');
    // Re-resolve paths for the target repo
    const { loadConfig: lc, resolvePaths: rp } = await import('../src/core/utils.mjs');
    const targetConfig = await lc(absRepo);
    const targetPaths = rp(absRepo, targetConfig);
    await runInit(targetPaths, targetConfig);
  } else {
    console.log(`   .agent/ already exists — skipping init.`);
  }

  console.log(`\n✅ Install complete. Run \`total-recall install --list\` to see all repos.\n`);
}

async function loadGlobalRepos(configPath) {
  if (!fs.existsSync(configPath)) return [];
  try {
    const mod = await import(`file://${configPath}`);
    return Array.isArray(mod.default?.repos) ? [...mod.default.repos] : [];
  } catch {
    return [];
  }
}

async function writeGlobalRepos(configPath, repos) {
  // Read existing config to preserve other fields
  let existingConfig = {};
  if (fs.existsSync(configPath)) {
    try {
      const mod = await import(`file://${configPath}?t=${Date.now()}`);
      existingConfig = { ...mod.default };
    } catch { /* fresh config */ }
  }

  existingConfig.repos = repos;

  const lines = [
    '// ~/.total-recall/config.mjs — User-global Total Recall configuration',
    'export default {',
    `  repos: [`,
    ...repos.map(r => `    '${r}',`),
    '  ],',
  ];

  // Preserve other keys
  for (const [key, value] of Object.entries(existingConfig)) {
    if (key === 'repos') continue;
    lines.push(`  ${key}: '${value}',`);
  }

  lines.push('};', '');
  fs.writeFileSync(configPath, lines.join('\n'));
}

// ─── INIT ───────────────────────────────────────────────────────────────────────

async function runInit(paths, config) {
  console.log('🧠 Total Recall — Initializing memory system...\n');

  const dirs = [
    paths.wikiDir,
    path.join(paths.wikiDir, 'preferences'),
    path.join(paths.wikiDir, 'patterns'),
    path.join(paths.wikiDir, 'anti-patterns'),
    path.join(paths.wikiDir, 'concepts'),
    path.join(paths.wikiDir, 'decisions'),
    path.join(paths.wikiDir, 'projects'),
    paths.dailyLogsDir,
    paths.episodesDir,
    paths.handoffsDir,
    path.join(paths.dataDir, 'learning'),
    path.join(paths.dataDir, 'knowledge'),
    // Project tracking Kanban (repo-level)
    path.join(ROOT, 'docs', 'projects', 'in-progress'),
    path.join(ROOT, 'docs', 'projects', 'backlog'),
    path.join(ROOT, 'docs', 'projects', 'planned'),
    path.join(ROOT, 'docs', 'projects', 'completed'),
    path.join(ROOT, 'docs', 'projects', 'archived'),
  ];

  for (const dir of dirs) {
    fs.mkdirSync(dir, { recursive: true });
    console.log(`  📁 ${path.relative(ROOT, dir)}/`);
  }

  // Copy SCHEMA.md template
  const templateSchema = path.join(__dirname, '..', 'templates', 'SCHEMA.md');
  const targetSchema = path.join(paths.wikiDir, 'SCHEMA.md');
  if (fs.existsSync(templateSchema) && !fs.existsSync(targetSchema)) {
    fs.copyFileSync(templateSchema, targetSchema);
    console.log(`  📄 ${path.relative(ROOT, targetSchema)}`);
  }

  // Create INDEX.md
  const indexPath = path.join(paths.wikiDir, 'INDEX.md');
  if (!fs.existsSync(indexPath)) {
    fs.writeFileSync(indexPath, '# Wiki Index\n\n> Auto-generated. Run `total-recall lint` to validate.\n');
    console.log(`  📄 ${path.relative(ROOT, indexPath)}`);
  }

  // Create identity files if they don't exist
  const identityFiles = [
    { path: paths.userMd, content: '# User Preferences\n\n> Agent-maintained user preference log.\n' },
    { path: paths.soulMd, content: '# Soul\n\n> Ethical mandates and behavioral boundaries.\n' },
    { path: paths.memoryMd, content: '# Memory\n\n> Condensed experience summary.\n' },
    { path: paths.identityMd, content: '# Identity\n\n> Agent persona definition.\n' },
  ];

  for (const { path: fp, content } of identityFiles) {
    if (!fs.existsSync(fp)) {
      fs.writeFileSync(fp, content);
      console.log(`  📄 ${path.relative(ROOT, fp)}`);
    }
  }

  // Create config template
  const configPath = path.join(ROOT, 'totalrecall.config.mjs');
  if (!fs.existsSync(configPath)) {
    const templateConfig = path.join(__dirname, '..', 'totalrecall.config.mjs');
    if (fs.existsSync(templateConfig)) {
      fs.copyFileSync(templateConfig, configPath);
    } else {
      fs.writeFileSync(configPath, `export default {\n  dataDir: '${config.dataDir}',\n  systemPromptFile: '${config.systemPromptFile}',\n};\n`);
    }
    console.log(`  ⚙️  totalrecall.config.mjs`);
  }

  // Initialize database
  const { openDatabase } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);
  db.close();
  console.log(`  💾 ${path.relative(ROOT, paths.dbPath)}`);

  console.log('\n✅ Memory system initialized. Run `total-recall reindex` to build the search index.\n');
}

// ─── UNINSTALL ──────────────────────────────────────────────────────────────────

async function runUninstall(paths, config) {
  const dryRun = args.includes('--dry-run');
  console.log(`🗑️  Total Recall — Uninstalling from project${dryRun ? ' (DRY RUN)' : ''}...\n`);

  // 1. Unsync IDE prompts
  console.log('  1. Removing injected behavioral surface from IDE rules...');
  process.argv.push('--unsync');
  if (dryRun) process.argv.push('--dry-run');
  await import('../src/core/sync-prompts.mjs');

  // 2. Unregister from global brain
  const GLOBAL_DIR = path.join(os.homedir(), '.total-recall');
  const GLOBAL_CONFIG = path.join(GLOBAL_DIR, 'config.mjs');
  const absRepo = path.resolve(ROOT);
  const tildeRepo = absRepo.replace(os.homedir(), '~');
  
  const repos = await loadGlobalRepos(GLOBAL_CONFIG);
  const filtered = repos.filter(r => r.replace(/^~/, os.homedir()) !== absRepo);
  
  if (filtered.length !== repos.length) {
    if (!dryRun) await writeGlobalRepos(GLOBAL_CONFIG, filtered);
    console.log(`\n  2. Unregistered "${tildeRepo}" from global registry`);
  } else {
    console.log(`\n  2. Repo was not registered in global registry`);
  }

  // 3. Remove .agent directory and config
  console.log('  3. Deleting memory data...');
  if (fs.existsSync(paths.dataDir)) {
    if (dryRun) {
      console.log(`     🏜️ Would delete directory: ${paths.dataDir}`);
    } else {
      fs.rmSync(paths.dataDir, { recursive: true, force: true });
      console.log(`     ✅ Deleted directory: ${paths.dataDir}`);
    }
  } else {
    console.log(`     ⏭️ Directory not found: ${paths.dataDir}`);
  }

  const configPath = path.join(ROOT, 'totalrecall.config.mjs');
  if (fs.existsSync(configPath)) {
    if (dryRun) {
      console.log(`     🏜️ Would delete file: ${configPath}`);
    } else {
      fs.unlinkSync(configPath);
      console.log(`     ✅ Deleted file: ${configPath}`);
    }
  }

  console.log(`\n✅ Uninstall complete. Your IDE rules are clean and the memory database is gone.\n`);
}

// ─── SEARCH ─────────────────────────────────────────────────────────────────────

async function runSearch(paths, args) {
  const term = args[0];
  if (!term) {
    console.log('Usage: total-recall search "term" [--source wiki|learning|daily-log|episode|handoff]');
    return;
  }

  const sourceIdx = args.indexOf('--source');
  const source = sourceIdx !== -1 ? args[sourceIdx + 1] : null;

  const { openDatabase, search, reindex } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);

  // Auto-reindex if empty
  const count = db.prepare('SELECT COUNT(*) as c FROM memory_fts').get().c;
  if (count === 0) {
    console.log('⚠️  FTS5 index is empty. Running reindex first...\n');
    const result = reindex(db, paths);
    console.log(`✅ Indexed ${result.totalIndexed} documents\n`);
  }

  const { results, error, fallback } = search(db, term, { source });

  const icons = { wiki: '📖', learning: '🧠', 'daily-log': '📅', episode: '📼', handoff: '🤝' };

  console.log(`🔍 Search: "${term}"${source ? ` [source: ${source}]` : ''}`);
  console.log(`   ${results.length} result(s)${fallback ? ' (LIKE fallback)' : ', ranked by BM25'}\n`);

  if (error) console.log(`   ⚠️  FTS5 error: ${error}\n`);

  for (const r of results) {
    const icon = icons[r.source] || '📄';
    if (r.source) {
      console.log(`  ${icon} [${r.source}] ${r.title}`);
      console.log(`     Category: ${r.category} | ID: ${r.source_id}`);
      console.log(`     ${r.snippet}`);
    } else {
      // Fallback result from learnings table
      console.log(`  🧠 [learning/${r.importance}] ${r.content.slice(0, 80)}...`);
    }
    console.log('');
  }

  db.close();
}

// ─── GRAPH ──────────────────────────────────────────────────────────────────────

async function runGraph(paths, args) {
  const slug = args[0];
  if (!slug) {
    console.log('Usage: total-recall graph "slug" [--depth N]');
    return;
  }

  const depthIdx = args.indexOf('--depth');
  const depth = depthIdx !== -1 ? parseInt(args[depthIdx + 1], 10) : 2;

  const { openDatabase, graphTraverse } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);
  const results = graphTraverse(db, slug, { depth });

  console.log(`🕸️  Graph: "${slug}" (depth: ${depth})\n`);

  if (results.length === 0) {
    console.log(`  No node found. Try: total-recall reindex\n`);
  } else {
    for (const r of results) {
      const indent = '  '.repeat(r.level);
      const label = r.level === 0 ? '🎯' : `L${r.level}`;
      console.log(`${indent}${label} ${r.title} [${r.category}]`);
      for (const e of r.edges) {
        console.log(`${indent}   ${e.direction} ${e.type}: ${e.connected}`);
      }
    }
    console.log(`\n  Traversed ${results.length} nodes`);
  }

  db.close();
}

// ─── NOTE ───────────────────────────────────────────────────────────────────────

/**
 * total-recall note --category TYPE "content"
 *
 * Full 5-layer cascade:
 *   1. Daily log  (.agent/memory/YYYY-MM-DD.md)       — always
 *   2. Identity quad (MEMORY.md or USER.md)           — by category
 *   3. steer()  → Total Recall wiki + INSTRUCTIONS.md — critical-failure / user-preference
 *   4. FTS5 index                                     — via steer()
 *   5. Learning DB                                    — critical-failure(9) / user-preference(8) / pattern(6)
 *
 * Categories:
 *   critical-failure  → MEMORY.md + steer(never, intensity 9)  + learning(importance 9)
 *   user-preference   → USER.md   + steer(prefer, intensity 8) + learning(importance 8)
 *   pattern           → learning DB (importance 6) only
 *   wiki              → wiki-queue for next dream cycle
 *   (none)            → daily log only
 */
async function runNote(paths, config, noteArgs) {
  const catIdx = noteArgs.indexOf('--category');
  const category = catIdx !== -1 ? noteArgs[catIdx + 1] : null;
  const contentArgs = noteArgs.filter((a, i) => {
    if (a === '--category') return false;
    if (i > 0 && noteArgs[i - 1] === '--category') return false;
    return true;
  });
  const content = contentArgs.join(' ').trim();

  if (!content) {
    console.log('Usage: total-recall note [--category critical-failure|user-preference|pattern|wiki] "Note content"');
    return;
  }

  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = now.toTimeString().split(' ')[0];

  // ── 1. Daily log ────────────────────────────────────────────────────────────
  const dailyLogPath = path.join(paths.dailyLogsDir, `${dateStr}.md`);
  fs.mkdirSync(paths.dailyLogsDir, { recursive: true });
  if (!fs.existsSync(dailyLogPath)) {
    fs.writeFileSync(dailyLogPath, `# Daily Log — ${dateStr}\n\n`);
  }
  const categoryTag = category ? ` [${category}]` : '';
  const entry = `- **${timeStr}**${categoryTag}: ${content}\n`;
  fs.appendFileSync(dailyLogPath, entry);
  console.log(`✅ Logged to daily: ${path.relative(ROOT, dailyLogPath)}`);

  // ── 2. Identity quad ────────────────────────────────────────────────────────
  if (category === 'critical-failure' && paths.memoryMd) {
    if (fs.existsSync(paths.memoryMd)) {
      fs.appendFileSync(paths.memoryMd, `\n## Active Memory Entry (${dateStr})\n- ${content}\n`);
      console.log(`🧠 Routed to MEMORY.md`);
    }
  }
  if (category === 'user-preference' && paths.userMd) {
    if (fs.existsSync(paths.userMd)) {
      fs.appendFileSync(paths.userMd, `\n- **${dateStr}**: ${content}\n`);
    } else {
      fs.writeFileSync(paths.userMd, `# User Preferences\n\n## Hard Rules\n- **${dateStr}**: ${content}\n`);
    }
    console.log(`👤 Routed to USER.md`);
  }
  if (category === 'wiki') {
    const wikiQueuePath = path.join(paths.dailyLogsDir, '.wiki-queue');
    fs.appendFileSync(wikiQueuePath, `${dateStr}|${content}\n`);
    console.log(`📚 Queued for wiki-compile`);
  }

  // ── 3+4. steer() → wiki node + INSTRUCTIONS.md + FTS5 ──────────────────────
  const steerTypeMap = { 'critical-failure': 'never', 'user-preference': 'prefer' };
  const steerType = steerTypeMap[category];

  if (steerType) {
    const { steer } = await import('../src/core/steering.mjs');
    const { openDatabase } = await import('../src/core/fts5.mjs');

    let db = null;
    if (fs.existsSync(paths.dbPath)) {
      const Database = (await import('better-sqlite3')).default;
      db = new Database(paths.dbPath);
    }

    const result = steer({
      type: steerType,
      directive: content,
      paths,
      db,
      intensity: category === 'critical-failure' ? 9 : 8,
      dryRun: false,
      behavioralSurfaceHeader: config.behavioralSurfaceHeader,
    });

    const steps = Object.entries(result.steps || {});
    for (const [step, status] of steps) {
      const icon = status?.includes('error') ? '❌' : '✅';
      console.log(`   ${icon} ${step}: ${status}`);
    }
    console.log(`🎯 Total Recall steer(${steerType}) complete — INSTRUCTIONS.md updated`);
    if (db) db.close();
  }

  // ── 5. Learning DB ──────────────────────────────────────────────────────────
  const importanceMap = { 'critical-failure': 9, 'user-preference': 8, 'pattern': 6 };
  const importance = importanceMap[category];
  const learningCategory = (category === 'critical-failure' || category === 'user-preference') ? 'user-pref' : category;

  if (importance !== undefined) {
    try {
      const Database = (await import('better-sqlite3')).default;
      fs.mkdirSync(path.dirname(paths.dbPath), { recursive: true });
      const db = new Database(paths.dbPath);

      // Ensure learnings table exists
      db.exec(`
        CREATE TABLE IF NOT EXISTS learnings (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          content TEXT NOT NULL,
          created_at TEXT DEFAULT (datetime('now')),
          category TEXT DEFAULT 'general',
          importance INTEGER DEFAULT 5,
          access_count INTEGER DEFAULT 0,
          last_accessed TEXT
        );
        CREATE UNIQUE INDEX IF NOT EXISTS idx_learnings_content ON learnings(substr(content, 1, 200));
      `);

      db.prepare(`
        INSERT OR IGNORE INTO learnings (content, category, importance)
        VALUES (?, ?, ?)
      `).run(content, learningCategory || 'general', importance);

      console.log(`📚 Learning DB → category: ${learningCategory}, importance: ${importance}`);
      db.close();
    } catch (err) {
      console.warn(`⚠️  Learning DB write failed (non-fatal): ${err.message?.split('\n')[0]}`);
    }
  }

  console.log(`\n📋 Note recorded → routed: ${category || 'daily log only'}`);
}

// ─── STEER ──────────────────────────────────────────────────────────────────────

async function runSteer(paths, config, args) {
  const typeIdx = args.indexOf('--type');
  if (typeIdx === -1 || !args[typeIdx + 1]) {
    console.log('Usage: total-recall steer --type never|always|correct|prefer "directive"');
    return;
  }

  const type = args[typeIdx + 1];
  const directiveArgs = [];
  for (let i = typeIdx + 2; i < args.length; i++) {
    if (args[i].startsWith('--')) break;
    directiveArgs.push(args[i]);
  }
  const directive = directiveArgs.join(' ').trim();

  if (!directive) {
    console.log('❌ No directive text provided.');
    return;
  }

  const intensityIdx = args.indexOf('--intensity');
  const intensity = intensityIdx !== -1 ? parseInt(args[intensityIdx + 1], 10) : null;
  const dryRun = args.includes('--dry-run');

  const { openDatabase } = await import('../src/core/fts5.mjs');
  const { steer } = await import('../src/core/steering.mjs');

  let db = null;
  if (fs.existsSync(paths.dbPath)) {
    const Database = (await import('better-sqlite3')).default;
    db = new Database(paths.dbPath);
  }

  console.log(`\n🔄 Steering: --type ${type} (${dryRun ? 'DRY RUN' : 'LIVE'})`);
  console.log(`   "${directive}"\n`);

  const result = steer({
    type,
    directive,
    paths,
    db,
    intensity,
    dryRun,
    behavioralSurfaceHeader: config.behavioralSurfaceHeader,
  });

  if (result.conflicts.length > 0) {
    console.log('   ⚠️  Potential conflicts:');
    for (const c of result.conflicts) {
      console.log(`      📖 ${c.title}`);
    }
    console.log('');
  }

  for (const [step, status] of Object.entries(result.steps)) {
    const icon = status.includes('error') ? '❌' : status === 'dry-run' ? '🏜️' : '✅';
    console.log(`   ${icon} ${step}: ${status}`);
  }

  console.log(`\n${dryRun ? '🏜️  DRY RUN complete.' : '✅ Steering complete.'}\n`);

  if (db) db.close();
}

// ─── REINDEX ────────────────────────────────────────────────────────────────────

async function runReindex(paths) {
  const { openDatabase, reindex } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);

  console.log('🔄 Rebuilding FTS5 search index...\n');
  const result = reindex(db, paths);

  const { breakdown } = result;
  console.log(`  📖 Wiki nodes: ${breakdown.wiki}`);
  console.log(`  🧠 Learnings: ${breakdown.learnings}`);
  console.log(`  📅 Daily logs: ${breakdown.dailyLogs}`);
  console.log(`  📼 Episodes: ${breakdown.episodes}`);
  console.log(`  🤝 Handoffs: ${breakdown.handoffs}`);
  console.log(`\n✅ Indexed ${result.totalIndexed} documents`);
  console.log(`🔗 ${result.edgeCount} edges in wiki_edges\n`);

  db.close();
}

// ─── COMPILE SURFACE ────────────────────────────────────────────────────────────

async function runCompileSurface(paths, config) {
  const { compileSurface, writeSurface } = await import('../src/core/surface.mjs');

  const preview = args.includes('--preview');
  const statsOnly = args.includes('--stats');

  const result = compileSurface({
    wikiDir: paths.wikiDir,
    root: paths.root,
    ranking: config.ranking,
  });

  if (!result) {
    console.log('📭 No wiki nodes with frontmatter found.\n');
    return;
  }

  if (statsOnly) {
    console.log('📊 Behavioral Surface — Ranking Details\n');
    console.log(`Total nodes: ${result.stats.totalNodes}`);
    console.log(`Negative: ${result.stats.negativeRules} | Positive: ${result.stats.positiveRules} | Corrective: ${result.stats.correctiveRules}`);
    console.log(`Steered: ${result.stats.steeredNodes}\n`);
    for (const n of result.nodes.slice(0, 15)) {
      console.log(`  ${n.score.toFixed(2)} | [${n.type}/${n.sentiment}] ${n.title}`);
    }
    return;
  }

  if (preview) {
    console.log('🔮 Preview:\n');
    console.log('─'.repeat(60));
    console.log(result.surface);
    console.log('─'.repeat(60));
    return;
  }

  const writeResult = writeSurface(
    paths.systemPrompt,
    result.surface,
    config.behavioralSurfaceHeader,
  );

  if (writeResult.success) {
    console.log('✅ Behavioral Surface written to', path.relative(ROOT, paths.systemPrompt));
    console.log(`   ${result.stats.totalNodes} nodes → ${result.stats.negativeRules} negative, ${result.stats.positiveRules} positive\n`);
  } else {
    console.log(`❌ ${writeResult.error}\n`);
  }
}

// ─── LINT ───────────────────────────────────────────────────────────────────────

async function runLint(paths) {
  const { lint } = await import('../src/core/wiki.mjs');
  const result = lint(paths.wikiDir);

  console.log(`🔍 Wiki Lint — ${result.pages} pages\n`);

  if (result.issues.errors.length > 0) {
    console.log(`🔴 ERRORS (${result.issues.errors.length}):`);
    for (const e of result.issues.errors) console.log(`  ❌ [${e.type}] ${e.slug}: ${e.detail}`);
    console.log('');
  }

  if (result.issues.warnings.length > 0) {
    console.log(`🟡 WARNINGS (${result.issues.warnings.length}):`);
    for (const w of result.issues.warnings) console.log(`  ⚠️  [${w.type}] ${w.slug}: ${w.detail}`);
    console.log('');
  }

  if (result.issues.info.length > 0) {
    console.log(`🔵 INFO (${result.issues.info.length}):`);
    for (const i of result.issues.info) console.log(`  ℹ️  [${i.type}] ${i.slug}: ${i.detail}`);
    console.log('');
  }

  const total = result.issues.errors.length + result.issues.warnings.length + result.issues.info.length;
  if (total === 0) {
    console.log('✅ Wiki is healthy.\n');
  } else if (result.hasErrors) {
    console.log('⛔ Fix all errors before proceeding.\n');
    process.exit(1);
  } else {
    console.log('✅ No blocking errors.\n');
  }
}

// ─── DREAM ──────────────────────────────────────────────────────────────────────

async function runDream(paths) {
  const { dream } = await import('../src/core/dream.mjs');
  const dryRun = args.includes('--dry-run');

  console.log(`💤 Dream Cycle${dryRun ? ' (DRY RUN)' : ''}...\n`);

  const result = dream({
    wikiDir: paths.wikiDir,
    dailyLogsDir: paths.dailyLogsDir,
    dryRun,
  });

  if (result.confidenceDecay.decayed > 0) {
    console.log(`📉 Confidence decay: ${result.confidenceDecay.decayed} nodes`);
    for (const d of result.confidenceDecay.details) {
      console.log(`   ${d.slug}: ${d.from} → ${d.to} (${d.daysSince}d, ${d.type})`);
    }
  } else {
    console.log('  No confidence decay needed.');
  }

  console.log(`\n✅ Dream cycle complete (${result.timestamp}).\n`);
}

// ─── HEARTBEAT (one-shot) ───────────────────────────────────────────────────

async function runHeartbeatCmd(paths, config) {
  const { compileSurface, writeSurfaceMulti } = await import('../src/core/surface.mjs');
  const { runConfidenceDecay, pruneStaleNodes, regenerateMemoryMd } = await import('../src/core/dream.mjs');

  const dryRun = args.includes('--dry-run');
  const t0 = Date.now();

  console.log(`💓 Heartbeat${dryRun ? ' (DRY RUN)' : ''}...\n`);

  // 1. Recompile behavioral surface with temporal context
  const surfaceResult = compileSurface({
    wikiDir: paths.wikiDir,
    root: paths.root,
    ranking: config.ranking,
    includeTemporalContext: true,
    episodesDir: paths.episodesDir,
  });

  if (surfaceResult) {
    if (!dryRun) {
      const targetFiles = paths.systemPromptFiles || [paths.systemPrompt];
      const writeResult = writeSurfaceMulti(
        targetFiles,
        surfaceResult.surface,
        config.behavioralSurfaceHeader,
      );
      const successes = writeResult.results.filter(r => r.success).length;
      console.log(`  🧠 Surface: ${surfaceResult.stats.totalNodes} nodes → ${successes}/${targetFiles.length} files`);
    } else {
      console.log(`  🧠 Surface: ${surfaceResult.stats.totalNodes} nodes (dry-run, not written)`);
    }
  } else {
    console.log('  📭 No wiki nodes — skipping surface compilation');
  }

  // 2. Confidence decay
  const decay = runConfidenceDecay(paths.wikiDir, { dryRun });
  if (decay.decayed > 0) {
    console.log(`  📉 Decay: ${decay.decayed} node(s)`);
    for (const d of decay.details) {
      console.log(`     ${d.slug}: ${d.from} → ${d.to} (${d.daysSince}d)`);
    }
  } else {
    console.log('  📉 Decay: none needed');
  }

  // 3. Prune stale nodes
  const prune = pruneStaleNodes({ wikiDir: paths.wikiDir, root: paths.root, dryRun });
  if (prune.pruned > 0) {
    console.log(`  🗑️  Pruned: ${prune.pruned} stale node(s) → .trash/`);
  } else {
    console.log('  🗑️  Pruned: none');
  }

  // 4. Regenerate MEMORY.md
  if (paths.memoryMd && !dryRun) {
    regenerateMemoryMd({ wikiDir: paths.wikiDir, memoryMd: paths.memoryMd });
    console.log(`  📄 MEMORY.md regenerated`);
  }

  // 5. Reindex FTS5
  if (!dryRun) {
    try {
      const { openDatabase, reindex } = await import('../src/core/fts5.mjs');
      const db = openDatabase(paths.dbPath);
      const result = reindex(db, paths);
      console.log(`  🔍 FTS5: ${result.totalIndexed} items indexed`);
      db.close();
    } catch (err) {
      console.log(`  ⚠️  FTS5 reindex failed: ${err.message}`);
    }
  }

  console.log(`\n✅ Heartbeat complete in ${Date.now() - t0}ms\n`);
}

// ─── STATS ──────────────────────────────────────────────────────────────────────

async function runStats(paths) {
  const { openDatabase, getStats } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);
  const stats = getStats(db, paths);

  const icons = { wiki: '📖', learning: '🧠', 'daily-log': '📅', episode: '📼', handoff: '🤝' };

  console.log('📊 Total Recall — Memory System Stats\n');
  console.log('═══ Layer 1: Episode Archive ═══');
  console.log(`  Episodes: ${stats.episodes}`);
  console.log(`  Daily logs: ${stats.dailyLogs}`);

  console.log('\n═══ Layer 2: Search Index (FTS5) ═══');
  console.log(`  Indexed documents: ${stats.ftsCount}`);
  for (const s of stats.ftsBySource) {
    console.log(`    ${icons[s.source] || '📄'} ${s.source}: ${s.c}`);
  }
  console.log(`  Graph edges: ${stats.edgeCount}`);

  console.log('\n═══ Layer 3: Knowledge Graph ═══');
  console.log(`  Wiki nodes: ${stats.wikiNodes}`);

  console.log('\n═══ Learnings ═══');
  console.log(`  Total: ${stats.totalLearnings}`);
  for (const c of stats.categories) {
    console.log(`    ${c.category}: ${c.c} (avg importance: ${(c.avg_imp || 5).toFixed(1)})`);
  }

  console.log('');
  db.close();
}

// ─── USAGE ──────────────────────────────────────────────────────────────────────

function printUsage() {
  console.log(`
🧠 Total Recall — Cognitive Memory System for AI Agents

Usage: total-recall <command> [options]

Commands:
  install [path]               Register a repo in the global brain
  install --list               Show all registered repos
  install --remove [path]      Unregister a repo
  init                         Scaffold .agent/ directory structure
  uninstall                    Unregister repo, unsync IDEs, and delete .agent/
  search "term"                FTS5 full-text search (BM25 ranked)
  graph "slug"                 Knowledge graph traversal (backlinks)
  note --category TYPE "text"  Log note with full 5-layer cascade
  steer --type TYPE "text"     Immediate behavioral cascade (fine-grained)
  reindex                      Rebuild FTS5 index from filesystem
  compile-surface              Regenerate DISTILLED MEMORY section
  lint                         Wiki integrity check
  dream                        Run consolidation cycle
  stats                        Memory system health report
  notify "title" "msg"         Enqueue notification (macOS + agent)
  notify --list                List pending notifications
  notify --drain               Drain and display all queued
  sync-prompts                 Sync behavioral surface to all IDE rule files
  sync-prompts --list          List detected IDEs
  heartbeat                    Run one heartbeat cycle (surface + decay + prune)

Options:
  --source TYPE                Filter search by: wiki|learning|daily-log|episode|handoff
  --depth N                    Graph traversal depth (default: 2)
  --type never|always|correct|prefer  Steer type
  --intensity N                Override sentiment intensity (1-10)
  --dry-run                    Show changes without writing
  --preview                    Preview surface without writing
  --stats                      Show ranking details for compile-surface
  --agent NAME                 Override pipeline agent for all roles
`);
}

// ─── SETUP ──────────────────────────────────────────────────────────────────────

/**
 * Setup Total Recall from scratch or from a hosted config URL.
 *
 * Usage:
 *   total-recall setup                        Interactive setup
 *   total-recall setup --config <URL>          Pull config from URL (prompts for password if encrypted)
 *   total-recall setup --share                 Encrypt and share config to stdout
 */
async function runSetup(setupArgs) {
  const GLOBAL_DIR = path.join(os.homedir(), '.total-recall');
  fs.mkdirSync(GLOBAL_DIR, { recursive: true, mode: 0o700 });

  const { encrypt, decrypt, isEncrypted } = await import('../src/core/crypto.mjs');

  // --share: encrypt config + env with a password and output to stdout
  if (setupArgs.includes('--share')) {
    const configPath = path.join(GLOBAL_DIR, 'config.mjs');
    const envPath = path.join(GLOBAL_DIR, '.env');

    // Collect all shareable content
    const parts = [];
    parts.push(`# Total Recall Config Bundle`);
    parts.push(`# Generated: ${new Date().toISOString()}`);
    parts.push(`# Machine: ${os.hostname()}\n`);

    if (fs.existsSync(configPath)) {
      parts.push('--- CONFIG.MJS ---');
      parts.push(fs.readFileSync(configPath, 'utf-8'));
    }
    if (fs.existsSync(envPath)) {
      parts.push('--- DOTENV ---');
      parts.push(fs.readFileSync(envPath, 'utf-8'));
    }

    const plaintext = parts.join('\n');

    // Prompt for password
    const password = await promptPassword('🔑 Set a password for this config: ');
    if (!password || password.length < 8) {
      console.error('❌ Password must be at least 8 characters.');
      process.exit(1);
    }
    const confirm = await promptPassword('🔑 Confirm password: ');
    if (password !== confirm) {
      console.error('❌ Passwords do not match.');
      process.exit(1);
    }

    const blob = encrypt(plaintext, password);
    console.log('\n' + blob);
    console.error(`\n✅ Encrypted config ready. Copy the output above and share it.`);
    console.error(`   Recipient runs: total-recall setup --config <URL-or-file>`);
    return;
  }

  // --config <URL or file>: pull config, decrypt if needed
  const configIdx = setupArgs.indexOf('--config');
  if (configIdx !== -1 && setupArgs[configIdx + 1]) {
    const source = setupArgs[configIdx + 1];
    let content;

    // Detect URL vs local file
    if (source.startsWith('http://') || source.startsWith('https://')) {
      console.log(`📡 Pulling config from: ${source}`);
      try {
        const response = await fetch(source);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        content = await response.text();
      } catch (err) {
        console.error(`❌ Failed to fetch: ${err.message}`);
        process.exit(1);
      }
    } else {
      // Local file
      const filePath = path.resolve(source.replace(/^~/, os.homedir()));
      if (!fs.existsSync(filePath)) {
        console.error(`❌ File not found: ${filePath}`);
        process.exit(1);
      }
      content = fs.readFileSync(filePath, 'utf-8');
    }

    // Decrypt if encrypted
    if (isEncrypted(content.trim())) {
      const password = await promptPassword('🔑 Enter password: ');
      try {
        content = decrypt(content.trim(), password);
        console.log('🔓 Decrypted successfully.');
      } catch (err) {
        console.error(`❌ ${err.message}`);
        process.exit(1);
      }
    }

    // Parse the bundle and save files
    saveConfigBundle(GLOBAL_DIR, content);

    console.log(`\n🎉 Setup complete! Run \`total-recall status\` to verify.`);
    return;
  }

  // Default: create skeleton config
  const configPath = path.join(GLOBAL_DIR, 'config.mjs');
  if (!fs.existsSync(configPath)) {
    fs.writeFileSync(configPath, `/**
 * Total Recall — Global Configuration
 * Location: ~/.total-recall/config.mjs
 *
 * This file is portable — copy it to any machine to restore your setup.
 * Share:  total-recall setup --share
 * Import: total-recall setup --config <URL-or-file>
 */
export default {
  repos: [],
  notifications: {
    channels: ['macos'],  // Add: 'slack', 'discord', 'email'
  },
  agents: {
    default: null,  // Override all pipeline roles: 'gemini', 'claude', etc.
  },
};
`);
    console.log(`✅ Created ${configPath}`);
  } else {
    console.log(`✅ Config already exists at ${configPath}`);
  }

  // Create .env skeleton
  const envPath = path.join(GLOBAL_DIR, '.env');
  if (!fs.existsSync(envPath)) {
    // Copy from .env.example in the package
    const examplePath = path.join(__dirname, '..', '.env.example');
    if (fs.existsSync(examplePath)) {
      fs.copyFileSync(examplePath, envPath);
      console.log(`✅ Created ${envPath} (from .env.example)`);
    } else {
      fs.writeFileSync(envPath, '# Total Recall Environment\n# See .env.example for available vars\n');
      console.log(`✅ Created ${envPath}`);
    }
    // Lock .env to owner-only (secrets file)
    fs.chmodSync(envPath, 0o600);
  }

  console.log(`\n📋 Next steps:`);
  console.log(`   1. Edit ~/.total-recall/.env with your API keys/webhooks`);
  console.log(`   2. Run \`total-recall install\` inside each repo`);
  console.log(`   3. Run \`total-recall status\` to verify integration`);
  console.log(`\n💡 To share this config: \`total-recall setup --share\``);
}

/**
 * Prompt for a password with hidden input.
 * @param {string} prompt
 * @returns {Promise<string>}
 */
function promptPassword(prompt) {
  return new Promise((resolve) => {
    const { createInterface } = require('readline');
    process.stderr.write(prompt);
    const rl = createInterface({ input: process.stdin, output: process.stderr, terminal: true });

    // Attempt to hide input
    if (process.stdin.isTTY) {
      process.stdin.setRawMode(true);
      let password = '';
      process.stdin.on('data', function handler(ch) {
        const c = ch.toString();
        if (c === '\n' || c === '\r' || c === '\u0004') {
          process.stdin.setRawMode(false);
          process.stdin.removeListener('data', handler);
          process.stderr.write('\n');
          rl.close();
          resolve(password);
        } else if (c === '\u007F' || c === '\b') {
          // Backspace
          if (password.length > 0) {
            password = password.slice(0, -1);
            process.stderr.write('\b \b');
          }
        } else {
          password += c;
          process.stderr.write('•');
        }
      });
    } else {
      // Non-TTY (piped input) — read line normally
      rl.question('', (answer) => {
        rl.close();
        resolve(answer);
      });
    }
  });
}

/**
 * Parse a config bundle (plaintext or decrypted) and save files.
 * Bundle format uses --- SECTION --- markers.
 *
 * @param {string} dir - Target directory (~/.total-recall/)
 * @param {string} content - Bundle content
 */
function saveConfigBundle(dir, content) {
  // Check for bundle section markers
  const hasConfig = content.includes('--- CONFIG.MJS ---');
  const hasEnv = content.includes('--- DOTENV ---');

  if (hasConfig || hasEnv) {
    // Parse bundle sections
    if (hasConfig) {
      const configStart = content.indexOf('--- CONFIG.MJS ---') + '--- CONFIG.MJS ---'.length;
      const configEnd = hasEnv ? content.indexOf('--- DOTENV ---') : content.length;
      const configContent = content.slice(configStart, configEnd).trim();
      const dest = path.join(dir, 'config.mjs');
      fs.writeFileSync(dest, configContent + '\n');
      console.log(`✅ Saved config.mjs`);
    }
    if (hasEnv) {
      const envStart = content.indexOf('--- DOTENV ---') + '--- DOTENV ---'.length;
      const envContent = content.slice(envStart).trim();
      const dest = path.join(dir, '.env');
      fs.writeFileSync(dest, envContent + '\n');
      fs.chmodSync(dest, 0o600);
      console.log(`✅ Saved .env`);
    }
  } else if (content.includes('export default') || content.includes('module.exports')) {
    const dest = path.join(dir, 'config.mjs');
    fs.writeFileSync(dest, content);
    console.log(`✅ Saved config.mjs`);
  } else if (content.includes('TOTAL_RECALL_')) {
    const dest = path.join(dir, '.env');
    fs.writeFileSync(dest, content);
    fs.chmodSync(dest, 0o600);
    console.log(`✅ Saved .env`);
  } else {
    const dest = path.join(dir, 'config.mjs');
    fs.writeFileSync(dest, content);
    console.log(`✅ Saved to config.mjs`);
  }
}

// ─── STATUS ─────────────────────────────────────────────────────────────────────

async function runStatus(paths) {
  const { loadEnv, getConfiguredIntegrations } = await import('../src/core/env.mjs');
  loadEnv(ROOT);
  const integrations = getConfiguredIntegrations();

  console.log('\n🧠 Total Recall Status\n');

  // Integrations
  console.log('📡 Integrations:');
  for (const [name, configured] of Object.entries(integrations)) {
    console.log(`   ${configured ? '🟢' : '⚪'} ${name}`);
  }

  // Notification channels
  try {
    const { listChannels } = await import('../src/notifications/dispatcher.mjs');
    const channels = listChannels();
    console.log('\n🔔 Notification Channels:');
    for (const [name, info] of Object.entries(channels)) {
      console.log(`   ${info.configured ? '🟢' : '⚪'} ${info.label} (${name})`);
    }
  } catch { /* dispatcher not available */ }

  // Registered repos
  const GLOBAL_CONFIG = path.join(os.homedir(), '.total-recall', 'config.mjs');
  try {
    const repos = await loadGlobalRepos(GLOBAL_CONFIG);
    console.log(`\n📂 Registered Repos: ${repos.length}`);
    for (const repo of repos) {
      console.log(`   ${repo}`);
    }
  } catch { /* no config */ }

  // Available agents
  try {
    const { checkAvailability } = await import('../src/agents/adapters/index.mjs');
    const agents = checkAvailability();
    console.log('\n🤖 CLI Agents:');
    for (const [name, info] of Object.entries(agents)) {
      console.log(`   ${info.available ? '🟢' : '⚪'} ${info.label} (${name})`);
    }
  } catch { /* adapters not available */ }

  // Available watchers
  try {
    const { listAvailable } = await import('../src/coprocessor/watchers/index.mjs');
    console.log('\n👁️  Available Watchers:');
    for (const name of listAvailable()) {
      console.log(`   📺 ${name}`);
    }
  } catch { /* watchers not available */ }

  console.log('');
}

// ─── NOTIFY ─────────────────────────────────────────────────────────────────────

async function runNotify(notifyArgs) {
  const { enqueue, drain, list, purgeStale } = await import('../src/coprocessor/notify.mjs');

  if (notifyArgs.includes('--list')) {
    const items = list();
    if (items.length === 0) {
      console.log('📭 No pending notifications');
    } else {
      console.log(`📬 ${items.length} pending notification(s):\n`);
      for (const item of items) {
        console.log(`  [${item.type.toUpperCase()}] ${item.title}`);
        console.log(`    ${item.message}`);
        console.log(`    ${item.timestamp}\n`);
      }
    }
    return;
  }

  if (notifyArgs.includes('--drain')) {
    const items = drain();
    console.log(`📬 Drained ${items.length} notification(s)`);
    for (const item of items) {
      console.log(`  [${item.type.toUpperCase()}] ${item.label}: ${item.text}`);
    }
    return;
  }

  if (notifyArgs.includes('--purge')) {
    const purged = purgeStale();
    console.log(`🗑️  Purged ${purged} stale notification(s)`);
    return;
  }

  // Default: enqueue
  const title = notifyArgs[0] || 'Total Recall';
  const message = notifyArgs[1] || 'Notification';
  let type = 'note';
  const typeIdx = notifyArgs.indexOf('--type');
  if (typeIdx !== -1 && notifyArgs[typeIdx + 1]) type = notifyArgs[typeIdx + 1];

  const result = enqueue({ title, message, type });
  console.log(`✅ Notification queued${result.desktopSent ? ' + desktop sent' : ''}`);
}

main().catch(err => {
  console.error('❌', err.message);
  process.exit(1);
});
