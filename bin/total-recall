#!/usr/bin/env node
/**
 * total-recall — CLI entry point
 *
 * Usage:
 *   total-recall init                       Scaffold vault + detect IDE
 *   total-recall compile                    Compile surface (Tier1 + skill injection)
 *   total-recall compile --dry-run          Preview without writing
 *   total-recall migrate                    Migrate legacy wiki → vault (dry-run by default)
 *   total-recall migrate --execute          Write migrated nodes
 *   total-recall resolve                    Resolve a quarantined conflict
 *   total-recall daemon start               Start Dream Cycle daemon
 *   total-recall daemon stop                Stop daemon
 *   total-recall daemon status              Report last run, next scheduled, PID
 *   total-recall dream                      Run one Dream Cycle immediately
 *   total-recall search "term"             FTS5 full-text search (BM25 ranked)
 *   total-recall steer --type never "..."  Immediate behavioral cascade
 *   total-recall note --category TYPE "..."  Log note
 *   total-recall reindex                    Rebuild FTS5 from filesystem
 *   total-recall stats                      Memory system health report
 *   total-recall conflicts                  List pending conflicts
 */

import path from 'path';
import os from 'os';
import fs from 'fs';
import { fileURLToPath } from 'url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = process.cwd();

const command = process.argv[2];
const args = process.argv.slice(3);

async function main() {
  const { loadConfig, resolvePaths } = await import('../src/core/utils.mjs');
  const config = await loadConfig(ROOT);
  const paths = resolvePaths(ROOT, config);

  switch (command) {
    case 'compile':
      await runCompile(paths, config, args);
      break;

    case 'migrate':
      await runMigrate(paths, args);
      break;

    case 'resolve':
      await runResolve(paths, args);
      break;

    case 'daemon':
      await runDaemon(paths, config, args);
      break;

    case 'conflicts':
      await runConflicts(paths, args);
      break;

    case 'install':
      await runInstall(paths, config);
      break;

    case 'init':
      await runInit(paths, config);
      break;

    case 'uninstall':
      await runUninstall(paths, config);
      break;

    case 'search':
      await runSearch(paths, args);
      break;

    case 'graph':
      await runGraph(paths, args);
      break;

    case 'steer':
      await runSteer(paths, config, args);
      break;

    case 'retract':
      await runRetract(paths, args);
      break;

    case 'edit':
      await runEdit(paths, args);
      break;

    case 'consult':
      await runConsult(paths, config, args);
      break;

    case 'note':
      await runNote(paths, config, args);
      break;

    case 'reindex':
      await runReindex(paths);
      break;

    case 'rebuild-graph':
      await runRebuildGraph(paths, config);
      break;

    case 'compile-surface':
      await runCompileSurface(paths, config);
      break;

    case 'lint':
      await runLint(paths);
      break;

    case 'heal':
      await runHeal(paths);
      break;

    case 'dream':
      await runDream(paths);
      break;

    case 'stats':
      await runStats(paths);
      break;

    case 'notify':
      await runNotify(args);
      break;

    case 'setup':
      await runSetup(args);
      break;

    case 'status':
      await runStatus(paths);
      break;

    case 'heartbeat':
      await runHeartbeatCmd(paths, config);
      break;

    case 'sync-prompts':
      // Delegate to the sync-prompts module (it handles its own args)
      await import('../src/core/sync-prompts.mjs');
      break;

    case 'health':
      await runHealth(paths, config);
      break;

    default:
      printUsage();
      break;
  }
}

// ─── INSTALL ────────────────────────────────────────────────────────────────────

async function runInstall(paths, config) {
  const GLOBAL_DIR = path.join(os.homedir(), '.total-recall');
  const GLOBAL_CONFIG = path.join(GLOBAL_DIR, 'config.mjs');

  // --list: show all registered repos
  if (args.includes('--list')) {
    const repos = await loadGlobalRepos(GLOBAL_CONFIG);
    if (repos.length === 0) {
      console.log('No repos registered. Run `total-recall install` inside a repo to register it.');
      return;
    }
    console.log(`\n📂 Registered Repos (${repos.length})\n`);
    for (const repo of repos) {
      const expanded = repo.replace(/^~/, os.homedir());
      const exists = fs.existsSync(expanded);
      const hasAgent = fs.existsSync(path.join(expanded, '.agent'));
      const status = !exists ? '❌ missing' : hasAgent ? '🟢 initialized' : '🟡 not initialized';
      console.log(`  ${status}  ${repo}`);
    }
    console.log('');
    return;
  }

  // Resolve which repo to install
  const targetRepo = args[0] || ROOT;
  const absRepo = path.resolve(targetRepo);
  const tildeRepo = absRepo.replace(os.homedir(), '~');

  // --remove: unregister a repo
  if (args.includes('--remove')) {
    const repos = await loadGlobalRepos(GLOBAL_CONFIG);
    const filtered = repos.filter(r => {
      const expanded = r.replace(/^~/, os.homedir());
      return expanded !== absRepo;
    });
    if (filtered.length === repos.length) {
      console.log(`⚠️  "${tildeRepo}" is not registered.`);
      return;
    }
    await writeGlobalRepos(GLOBAL_CONFIG, filtered);
    console.log(`🗑️  Removed "${tildeRepo}" from registry. (${filtered.length} repos remaining)`);
    return;
  }

  // Validate it's a real directory
  if (!fs.existsSync(absRepo)) {
    console.log(`❌ Directory not found: ${absRepo}`);
    process.exit(1);
  }

  // Register in global config
  fs.mkdirSync(GLOBAL_DIR, { recursive: true });
  const repos = await loadGlobalRepos(GLOBAL_CONFIG);
  const alreadyRegistered = repos.some(r => r.replace(/^~/, os.homedir()) === absRepo);

  if (alreadyRegistered) {
    console.log(`✅ "${tildeRepo}" is already registered.`);
  } else {
    repos.push(tildeRepo);
    await writeGlobalRepos(GLOBAL_CONFIG, repos);
    console.log(`📌 Registered "${tildeRepo}" (${repos.length} repos total)`);
  }

  // Auto-init if not already initialized
  const hasAgent = fs.existsSync(path.join(absRepo, '.agent'));
  if (!hasAgent) {
    console.log('\n🔧 Repo not initialized — running init...\n');
    // Re-resolve paths for the target repo
    const { loadConfig: lc, resolvePaths: rp } = await import('../src/core/utils.mjs');
    const targetConfig = await lc(absRepo);
    const targetPaths = rp(absRepo, targetConfig);
    await runInit(targetPaths, targetConfig);
  } else {
    console.log(`   .agent/ already exists — skipping init.`);
  }

  console.log(`\n✅ Install complete. Run \`total-recall install --list\` to see all repos.\n`);
}

async function loadGlobalRepos(configPath) {
  if (!fs.existsSync(configPath)) return [];
  try {
    const mod = await import(`file://${configPath}`);
    return Array.isArray(mod.default?.repos) ? [...mod.default.repos] : [];
  } catch {
    return [];
  }
}

async function writeGlobalRepos(configPath, repos) {
  // Read existing config to preserve other fields
  let existingConfig = {};
  if (fs.existsSync(configPath)) {
    try {
      const mod = await import(`file://${configPath}?t=${Date.now()}`);
      existingConfig = { ...mod.default };
    } catch { /* fresh config */ }
  }

  existingConfig.repos = repos;

  const lines = [
    '// ~/.total-recall/config.mjs — User-global Total Recall configuration',
    'export default {',
    `  repos: [`,
    ...repos.map(r => `    '${r}',`),
    '  ],',
  ];

  // Preserve other keys
  for (const [key, value] of Object.entries(existingConfig)) {
    if (key === 'repos') continue;
    lines.push(`  ${key}: '${value}',`);
  }

  lines.push('};', '');
  fs.writeFileSync(configPath, lines.join('\n'));
}

// ─── INIT ───────────────────────────────────────────────────────────────────────

async function runInit(paths, config) {
  console.log('🧠 Total Recall — Initializing SSSS 3-Tier Memory System...\n');

  // ── Auto-detect IDE ────────────────────────────────────────────────────────
  const ideDetectors = [
    { file: 'CLAUDE.md',       ide: 'claude-code',   watcher: 'claude-code' },
    { file: '.cursorrules',    ide: 'Cursor',         watcher: 'cursor' },
    { file: 'AGENTS.md',       ide: 'Antigravity',    watcher: 'antigravity' },
    { file: 'INSTRUCTIONS.md', ide: 'Antigravity',    watcher: 'antigravity' },
    { file: '.clinerules',     ide: 'Cline',          watcher: 'cline' },
  ];
  let detectedIde = 'generic';
  let instructionsTarget = path.join(ROOT, 'INSTRUCTIONS.md');
  for (const d of ideDetectors) {
    if (fs.existsSync(path.join(ROOT, d.file))) {
      detectedIde = d.ide;
      instructionsTarget = path.join(ROOT, d.file);
      break;
    }
  }
  console.log(`  🔍 IDE detected: ${detectedIde}`);
  console.log(`  📄 Instructions target: ${path.relative(ROOT, instructionsTarget)}\n`);

  // ── Scaffold SSSS vault dirs ───────────────────────────────────────────────
  const vaultDir = paths.vaultDir ?? path.join(paths.dataDir, 'memory-vault');
  const vaultDirs = [
    path.join(vaultDir, 'invariants'),
    path.join(vaultDir, 'preferences'),
    path.join(vaultDir, 'anti-patterns'),
    path.join(vaultDir, 'patterns'),
    path.join(vaultDir, 'decisions'),
    path.join(vaultDir, 'concepts'),
    path.join(paths.dataDir, 'memory-derived'),
    path.join(paths.dataDir, 'memory-inbox', 'pending'),
    path.join(paths.dataDir, 'memory-inbox', 'conflicts'),
    path.join(paths.dataDir, 'sessions'),
  ];

  for (const dir of vaultDirs) {
    fs.mkdirSync(dir, { recursive: true });
    console.log(`  📁 ${path.relative(ROOT, dir)}/`);
  }

  // ── Create INSTRUCTIONS.md stub if missing ────────────────────────────────
  if (!fs.existsSync(instructionsTarget)) {
    fs.writeFileSync(instructionsTarget,
      `# Agent Rules\n> Tier 1 Hot Memory — compiled by Total Recall. Edit memory-vault/invariants/ to change rules.\n\n`
    );
    console.log(`  📄 ${path.relative(ROOT, instructionsTarget)} (created)`);
  } else {
    console.log(`  ✅ ${path.relative(ROOT, instructionsTarget)} already exists`);
  }

  // ── Scaffold the Total Recall Expert Skill ──────────────────────────────────
  const skillsDir = paths.skillsDir ?? path.join(paths.dataDir, 'skills');
  const trSkillDir = path.join(skillsDir, 'total-recall');
  const templateBundleDir = path.join(__dirname, '..', 'templates', 'skill-bundle');
  
  if (fs.existsSync(templateBundleDir)) {
    if (!fs.existsSync(trSkillDir)) {
      fs.cpSync(templateBundleDir, trSkillDir, { recursive: true });
      console.log(`  📁 ${path.relative(ROOT, trSkillDir)}/ (Expert Skill Scaffolded)`);
    } else {
      console.log(`  ✅ ${path.relative(ROOT, trSkillDir)} already exists`);
    }
  } else {
    // Fallback if template is missing
    fs.mkdirSync(path.join(trSkillDir, 'scripts'), { recursive: true });
    fs.mkdirSync(path.join(trSkillDir, 'references'), { recursive: true });
    const trSkillPath = path.join(trSkillDir, 'SKILL.md');
    if (!fs.existsSync(trSkillPath)) {
      fs.writeFileSync(trSkillPath, `---
name: total-recall
description: The ultimate SSOT for the workspace memory system. Use this skill to add rules, resolve memory conflicts, run the compiler, and manage the Dream Cycle.
version: 1.0.0
schema_version: 2
---

# Total Recall (Memory Manager)

You are now the expert administrator of this workspace's Total Recall memory system. This system replaces legacy context files with a 3-tier SSSS-compliant Markdown vault.

## Your Mandate
When the user tells you to "remember this" or "always do X":
1. Do **NOT** try to edit \`INSTRUCTIONS.md\` directly.
2. Create or update an SSSS-compliant Markdown node in \`.agent/memory-vault/\`.
3. Run \`npx total-recall compile\` to automatically route your node into the hot memory.
`);
      console.log(`  📁 ${path.relative(ROOT, trSkillDir)}/ (Expert Skill Scaffolded via Fallback)`);
    }
  }

  // ── Create config if missing ───────────────────────────────────────────────
  const configPath = path.join(ROOT, 'totalrecall.config.mjs');
  if (!fs.existsSync(configPath)) {
    const templateConfig = path.join(__dirname, '..', 'totalrecall.config.mjs');
    if (fs.existsSync(templateConfig)) {
      fs.copyFileSync(templateConfig, configPath);
    } else {
      fs.writeFileSync(configPath,
        `export default {\n  dataDir: '.agent',\n  systemPromptFile: '${path.relative(ROOT, instructionsTarget)}',\n  watcher: '${detectedIde === 'generic' ? 'generic' : 'antigravity'}',\n};\n`
      );
    }
    console.log(`  ⚙️  totalrecall.config.mjs`);
  }

  console.log(`
✅ Total Recall initialized!

Next steps:
  1. Add memory nodes to ${path.relative(ROOT, vaultDir)}/invariants/
  2. Run \`total-recall compile\` to build INSTRUCTIONS.md
  3. Run \`total-recall daemon start\` to start the Dream Cycle
  4. Run \`total-recall migrate\` if you have an existing memory-wiki to convert
`);
}


// ─── UNINSTALL ──────────────────────────────────────────────────────────────────

async function runUninstall(paths, config) {
  const dryRun = args.includes('--dry-run');
  console.log(`🗑️  Total Recall — Uninstalling from project${dryRun ? ' (DRY RUN)' : ''}...\n`);

  // 1. Unsync IDE prompts
  console.log('  1. Removing injected behavioral surface from IDE rules...');
  process.argv.push('--unsync');
  if (dryRun) process.argv.push('--dry-run');
  await import('../src/core/sync-prompts.mjs');

  // 2. Unregister from global brain
  const GLOBAL_DIR = path.join(os.homedir(), '.total-recall');
  const GLOBAL_CONFIG = path.join(GLOBAL_DIR, 'config.mjs');
  const absRepo = path.resolve(ROOT);
  const tildeRepo = absRepo.replace(os.homedir(), '~');
  
  const repos = await loadGlobalRepos(GLOBAL_CONFIG);
  const filtered = repos.filter(r => r.replace(/^~/, os.homedir()) !== absRepo);
  
  if (filtered.length !== repos.length) {
    if (!dryRun) await writeGlobalRepos(GLOBAL_CONFIG, filtered);
    console.log(`\n  2. Unregistered "${tildeRepo}" from global registry`);
  } else {
    console.log(`\n  2. Repo was not registered in global registry`);
  }

  // 3. Remove .agent directory and config
  console.log('  3. Deleting memory data...');
  if (fs.existsSync(paths.dataDir)) {
    if (dryRun) {
      console.log(`     🏜️ Would delete directory: ${paths.dataDir}`);
    } else {
      fs.rmSync(paths.dataDir, { recursive: true, force: true });
      console.log(`     ✅ Deleted directory: ${paths.dataDir}`);
    }
  } else {
    console.log(`     ⏭️ Directory not found: ${paths.dataDir}`);
  }

  const configPath = path.join(ROOT, 'totalrecall.config.mjs');
  if (fs.existsSync(configPath)) {
    if (dryRun) {
      console.log(`     🏜️ Would delete file: ${configPath}`);
    } else {
      fs.unlinkSync(configPath);
      console.log(`     ✅ Deleted file: ${configPath}`);
    }
  }

  console.log(`\n✅ Uninstall complete. Your IDE rules are clean and the memory database is gone.\n`);
}

// ─── SEARCH ─────────────────────────────────────────────────────────────────────

async function runSearch(paths, args) {
  const term = args[0];
  if (!term) {
    console.log('Usage: total-recall search "term" [--source wiki|learning|daily-log|episode|handoff]');
    return;
  }

  const sourceIdx = args.indexOf('--source');
  const source = sourceIdx !== -1 ? args[sourceIdx + 1] : null;

  const { openDatabase, search, reindex } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);

  // Auto-reindex if empty
  const count = db.prepare('SELECT COUNT(*) as c FROM memory_fts').get().c;
  if (count === 0) {
    console.log('⚠️  FTS5 index is empty. Running reindex first...\n');
    const result = reindex(db, paths);
    console.log(`✅ Indexed ${result.totalIndexed} documents\n`);
  }

  const { results, error, fallback } = search(db, term, { source });

  const icons = { wiki: '📖', learning: '🧠', 'daily-log': '📅', episode: '📼', handoff: '🤝' };

  console.log(`🔍 Search: "${term}"${source ? ` [source: ${source}]` : ''}`);
  console.log(`   ${results.length} result(s)${fallback ? ' (LIKE fallback)' : ', ranked by BM25'}\n`);

  if (error) console.log(`   ⚠️  FTS5 error: ${error}\n`);

  for (const r of results) {
    const icon = icons[r.source] || '📄';
    if (r.source) {
      console.log(`  ${icon} [${r.source}] ${r.title}`);
      console.log(`     Category: ${r.category} | ID: ${r.source_id}`);
      console.log(`     ${r.snippet}`);
    } else {
      // Fallback result from learnings table
      console.log(`  🧠 [learning/${r.importance}] ${r.content.slice(0, 80)}...`);
    }
    console.log('');
  }

  db.close();
}

// ─── GRAPH ──────────────────────────────────────────────────────────────────────

async function runGraph(paths, args) {
  const slug = args[0];
  if (!slug) {
    console.log('Usage: total-recall graph "slug" [--depth N]');
    return;
  }

  const depthIdx = args.indexOf('--depth');
  const depth = depthIdx !== -1 ? parseInt(args[depthIdx + 1], 10) : 2;

  const { openDatabase, graphTraverse } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);
  const results = graphTraverse(db, slug, { depth });

  console.log(`🕸️  Graph: "${slug}" (depth: ${depth})\n`);

  if (results.length === 0) {
    console.log(`  No node found. Try: total-recall reindex\n`);
  } else {
    for (const r of results) {
      const indent = '  '.repeat(r.level);
      const label = r.level === 0 ? '🎯' : `L${r.level}`;
      console.log(`${indent}${label} ${r.title} [${r.category}]`);
      for (const e of r.edges) {
        console.log(`${indent}   ${e.direction} ${e.type}: ${e.connected}`);
      }
    }
    console.log(`\n  Traversed ${results.length} nodes`);
  }

  db.close();
}

// ─── NOTE ───────────────────────────────────────────────────────────────────────

/**
 * total-recall note --category TYPE "content"
 *
 * Full 5-layer cascade:
 *   1. Daily log  (.agent/memory/YYYY-MM-DD.md)       — always
 *   2. Identity quad (MEMORY.md or USER.md)           — by category
 *   3. steer()  → Total Recall wiki + INSTRUCTIONS.md — critical-failure / user-preference
 *   4. FTS5 index                                     — via steer()
 *   5. Learning DB                                    — critical-failure(9) / user-preference(8) / pattern(6)
 *
 * Categories:
 *   critical-failure  → MEMORY.md + steer(never, intensity 9)  + learning(importance 9)
 *   user-preference   → USER.md   + steer(prefer, intensity 8) + learning(importance 8)
 *   pattern           → learning DB (importance 6) only
 *   wiki              → wiki-queue for next dream cycle
 *   (none)            → daily log only
 */
async function runNote(paths, config, noteArgs) {
  const catIdx = noteArgs.indexOf('--category');
  const category = catIdx !== -1 ? noteArgs[catIdx + 1] : null;

  if (!category) {
    console.error('❌ Error: --category is REQUIRED.');
    console.error('Usage: total-recall note --category <critical-failure|user-preference|pattern|wiki> "Note content"');
    process.exit(1);
  }

  const contentArgs = noteArgs.filter((a, i) => {
    if (a === '--category') return false;
    if (i > 0 && noteArgs[i - 1] === '--category') return false;
    return true;
  });
  const content = contentArgs.join(' ').trim();

  if (!content) {
    console.log('Usage: total-recall note [--category critical-failure|user-preference|pattern|wiki] "Note content"');
    return;
  }

  const now = new Date();
  const dateStr = now.toISOString().split('T')[0];
  const timeStr = now.toTimeString().split(' ')[0];

  // ── 1. Daily log ────────────────────────────────────────────────────────────
  const dailyLogPath = path.join(paths.dailyLogsDir, `${dateStr}.md`);
  fs.mkdirSync(paths.dailyLogsDir, { recursive: true });
  if (!fs.existsSync(dailyLogPath)) {
    fs.writeFileSync(dailyLogPath, `# Daily Log — ${dateStr}\n\n`);
  }
  const categoryTag = category ? ` [${category}]` : '';
  const entry = `- **${timeStr}**${categoryTag}: ${content}\n`;
  fs.appendFileSync(dailyLogPath, entry);
  console.log(`✅ Logged to daily: ${path.relative(ROOT, dailyLogPath)}`);

  // ── 2. Identity quad ────────────────────────────────────────────────────────
  if (category === 'critical-failure' && paths.memoryMd) {
    if (fs.existsSync(paths.memoryMd)) {
      fs.appendFileSync(paths.memoryMd, `\n## Active Memory Entry (${dateStr})\n- ${content}\n`);
      console.log(`🧠 Routed to MEMORY.md`);
    }
  }
  if (category === 'user-preference' && paths.userMd) {
    if (fs.existsSync(paths.userMd)) {
      fs.appendFileSync(paths.userMd, `\n- **${dateStr}**: ${content}\n`);
    } else {
      fs.writeFileSync(paths.userMd, `# User Preferences\n\n## Hard Rules\n- **${dateStr}**: ${content}\n`);
    }
    console.log(`👤 Routed to USER.md`);
  }
  if (category === 'wiki') {
    const wikiQueuePath = path.join(paths.dailyLogsDir, '.wiki-queue');
    fs.appendFileSync(wikiQueuePath, `${dateStr}|${content}\n`);
    console.log(`📚 Queued for wiki-compile`);
  }

  // ── 3+4. steer() → wiki node + INSTRUCTIONS.md + FTS5 ──────────────────────
  const steerTypeMap = { 'critical-failure': 'never', 'user-preference': 'prefer' };
  const steerType = steerTypeMap[category];

  if (steerType) {
    const { steer } = await import('../src/core/steering.mjs');
    const { openDatabase } = await import('../src/core/fts5.mjs');

    let db = null;
    if (fs.existsSync(paths.dbPath)) {
      const Database = (await import('better-sqlite3')).default;
      db = new Database(paths.dbPath);
    }

    const result = steer({
      type: steerType,
      directive: content,
      paths,
      db,
      intensity: category === 'critical-failure' ? 9 : 8,
      dryRun: false,
      behavioralSurfaceHeader: config.behavioralSurfaceHeader,
    });

    const steps = Object.entries(result.steps || {});
    for (const [step, status] of steps) {
      const icon = status?.includes('error') ? '❌' : '✅';
      console.log(`   ${icon} ${step}: ${status}`);
    }
    console.log(`🎯 Total Recall steer(${steerType}) complete — INSTRUCTIONS.md updated`);
    if (db) db.close();
  }

  // ── 5. Learning DB ──────────────────────────────────────────────────────────
  const importanceMap = { 'critical-failure': 9, 'user-preference': 8, 'pattern': 6 };
  const importance = importanceMap[category];
  const learningCategory = (category === 'critical-failure' || category === 'user-preference') ? 'user-pref' : category;

  if (importance !== undefined) {
    try {
      const Database = (await import('better-sqlite3')).default;
      fs.mkdirSync(path.dirname(paths.dbPath), { recursive: true });
      const db = new Database(paths.dbPath);

      // Ensure learnings table exists
      db.exec(`
        CREATE TABLE IF NOT EXISTS learnings (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          content TEXT NOT NULL,
          created_at TEXT DEFAULT (datetime('now')),
          category TEXT DEFAULT 'general',
          importance INTEGER DEFAULT 5,
          access_count INTEGER DEFAULT 0,
          last_accessed TEXT
        );
        CREATE UNIQUE INDEX IF NOT EXISTS idx_learnings_content ON learnings(substr(content, 1, 200));
      `);

      db.prepare(`
        INSERT OR IGNORE INTO learnings (content, category, importance)
        VALUES (?, ?, ?)
      `).run(content, learningCategory || 'general', importance);

      console.log(`📚 Learning DB → category: ${learningCategory}, importance: ${importance}`);
      db.close();
    } catch (err) {
      console.warn(`⚠️  Learning DB write failed (non-fatal): ${err.message?.split('\n')[0]}`);
    }
  }

  console.log(`\n📋 Note recorded → routed: ${category || 'daily log only'}`);
}

// ─── RETRACT ────────────────────────────────────────────────────────────────────

async function runRetract(paths, args) {
  const slug = args[0];
  if (!slug) {
    console.log('Usage: total-recall retract "slug"');
    return;
  }

  const { walkMarkdown } = await import('../src/core/utils.mjs');
  const files = walkMarkdown(paths.wikiDir);
  const target = files.find(f => path.basename(f) === `${slug}.md`);

  if (!target) {
    console.log(`❌ No memory node found with slug: "${slug}"`);
    return;
  }

  fs.unlinkSync(target);
  console.log(`✅ Retracted memory node: ${slug}`);

  const { openDatabase, reindex } = await import('../src/core/fts5.mjs');
  if (fs.existsSync(paths.dbPath)) {
    const Database = (await import('better-sqlite3')).default;
    const db = new Database(paths.dbPath);
    reindex(db, paths);
    db.close();
    console.log(`🔄 Search index recompiled.`);
  }
  
  console.log(`🎯 Retraction complete. You may want to run \`total-recall compile-surface\` to update INSTRUCTIONS.md`);
}

// ─── EDIT ───────────────────────────────────────────────────────────────────────

async function runEdit(paths, args) {
  const slug = args[0];
  if (!slug) {
    console.log('Usage: total-recall edit "slug" [--overwrite "content"]');
    return;
  }

  const { walkMarkdown } = await import('../src/core/utils.mjs');
  const files = walkMarkdown(paths.wikiDir);
  const target = files.find(f => path.basename(f) === `${slug}.md`);

  if (!target) {
    console.log(`❌ No memory node found with slug: "${slug}"`);
    return;
  }

  const overwriteIdx = args.indexOf('--overwrite');
  if (overwriteIdx !== -1 && args[overwriteIdx + 1]) {
    fs.writeFileSync(target, args[overwriteIdx + 1]);
    console.log(`✅ Overwrote memory node: ${slug}`);
  } else {
    const editor = process.env.EDITOR || 'vi';
    console.log(`📝 Opening ${target} in ${editor}...`);
    const { spawnSync } = await import('child_process');
    spawnSync(editor, [target], { stdio: 'inherit' });
    console.log(`✅ Edit complete: ${slug}`);
  }

  const { openDatabase, reindex } = await import('../src/core/fts5.mjs');
  if (fs.existsSync(paths.dbPath)) {
    const Database = (await import('better-sqlite3')).default;
    const db = new Database(paths.dbPath);
    reindex(db, paths);
    db.close();
    console.log(`🔄 Search index recompiled.`);
  }
}

// ─── STEER ──────────────────────────────────────────────────────────────────────

async function runSteer(paths, config, args) {
  // --history: show all past steers from USER.md
  if (args.includes('--history')) {
    if (fs.existsSync(paths.userMd)) {
      const content = fs.readFileSync(paths.userMd, 'utf-8');
      const steerLines = content.split('\n').filter(l => l.includes('[STEER/'));
      console.log(`\n\ud83d\udcdc Steer History (${steerLines.length} entries):\n`);
      for (const line of steerLines) {
        console.log(`  ${line.trim()}`);
      }
      if (steerLines.length === 0) console.log('  No steers recorded yet.');
      console.log('');
    } else {
      console.log('No USER.md found.');
    }
    return;
  }

  const typeIdx = args.indexOf('--type');
  if (typeIdx === -1 || !args[typeIdx + 1]) {
    console.log('Usage: total-recall steer --type never|always|correct|prefer "directive"');
    return;
  }

  const type = args[typeIdx + 1];
  const directiveArgs = [];
  for (let i = typeIdx + 2; i < args.length; i++) {
    if (args[i].startsWith('--')) break;
    directiveArgs.push(args[i]);
  }
  const directive = directiveArgs.join(' ').trim();

  if (!directive) {
    console.log('❌ No directive text provided.');
    return;
  }

  const intensityIdx = args.indexOf('--intensity');
  const intensity = intensityIdx !== -1 ? parseInt(args[intensityIdx + 1], 10) : null;
  const dryRun = args.includes('--dry-run');

  const { openDatabase } = await import('../src/core/fts5.mjs');
  const { steer } = await import('../src/core/steering.mjs');

  let db = null;
  if (fs.existsSync(paths.dbPath)) {
    const Database = (await import('better-sqlite3')).default;
    db = new Database(paths.dbPath);
  }

  console.log(`\n🔄 Steering: --type ${type} (${dryRun ? 'DRY RUN' : 'LIVE'})`);
  console.log(`   "${directive}"\n`);

  const result = steer({
    type,
    directive,
    paths,
    db,
    intensity,
    dryRun,
    behavioralSurfaceHeader: config.behavioralSurfaceHeader,
  });

  if (result.conflicts.length > 0) {
    console.log('   ⚠️  Potential conflicts:');
    for (const c of result.conflicts) {
      console.log(`      📖 ${c.title}`);
    }
    console.log('');
  }

  for (const [step, status] of Object.entries(result.steps)) {
    const icon = status.includes('error') ? '❌' : status === 'dry-run' ? '🏜️' : '✅';
    console.log(`   ${icon} ${step}: ${status}`);
  }

  console.log(`\n${dryRun ? '🏜️  DRY RUN complete.' : '✅ Steering complete.'}\n`);

  if (db) db.close();
}

// ─── REINDEX ────────────────────────────────────────────────────────────────────

async function runReindex(paths) {
  const { openDatabase, reindex } = await import('../src/core/fts5.mjs');
  const db = openDatabase(paths.dbPath);

  console.log('🔄 Rebuilding FTS5 search index...\n');
  const result = reindex(db, paths);

  const { breakdown } = result;
  console.log(`  📖 Wiki nodes: ${breakdown.wiki}`);
  console.log(`  🧠 Learnings: ${breakdown.learnings}`);
  console.log(`  📅 Daily logs: ${breakdown.dailyLogs}`);
  console.log(`  📼 Episodes: ${breakdown.episodes}`);
  console.log(`  🤝 Handoffs: ${breakdown.handoffs}`);
  console.log(`\n✅ Indexed ${result.totalIndexed} documents`);
  console.log(`🔗 ${result.edgeCount} edges in wiki_edges\n`);

  db.close();
}

// ─── REBUILD GRAPH ──────────────────────────────────────────────────────────────

async function runRebuildGraph(paths, config) {
  const { openDatabase } = await import('../src/core/fts5.mjs');
  const { rebuildGraph } = await import('../src/core/graph.mjs');
  
  const db = openDatabase(paths.dbPath);
  const deterministic = args.includes('--deterministic');
  
  try {
    console.log(`\ud83d\udd78\ufe0f  Rebuilding instruction graph from wiki nodes${deterministic ? ' (deterministic mode)' : ''}...\n`);
    const result = await rebuildGraph(db, paths, config, { deterministic });
    console.log(`\n\u2705 Graph rebuild complete!`);
    console.log(`  Nodes synthesized: ${result.nodeCount}`);
    console.log(`  Edges inferred: ${result.edgeCount}\n`);
  } catch (err) {
    console.error(`\n\u274c Graph rebuild failed: ${err.message}\n`);
  } finally {
    db.close();
  }
}

// ─── COMPILE (SSSS 3-TIER) ───────────────────────────────────────────────────────

async function runCompile(paths, config, compileArgs) {
  const { compileSurface } = await import('../src/core/surface.mjs');
  const dryRun = compileArgs.includes('--dry-run');

  const vaultDir = paths.vaultDir ?? path.join(paths.dataDir, 'memory-vault');
  const skillsDir = paths.skillsDir ?? path.join(ROOT, '.agent', 'skills');
  const derivedDir = paths.derivedDir ?? path.join(paths.dataDir, 'memory-derived');
  const instructionsFile = paths.instructionsFile
    ?? path.join(ROOT, config.systemPromptFile ?? 'INSTRUCTIONS.md');

  console.log('\n🧠 Total Recall — Surface Compiler (SSSS 3-Tier)\n');
  console.log(`   Vault:        ${path.relative(ROOT, vaultDir)}`);
  console.log(`   Skills:       ${path.relative(ROOT, skillsDir)}`);
  console.log(`   Mode:         ${dryRun ? 'DRY RUN' : 'LIVE'}\n`);

  if (!fs.existsSync(vaultDir)) {
    console.error(`❌ Vault not found: ${vaultDir}`);
    console.error('   Run `total-recall init` first.\n');
    process.exit(1);
  }

  let db = null;
  try {
    const Database = (await import('better-sqlite3')).default;
    const dbPath = paths.dbPath ?? path.join(paths.dataDir, 'memory.db');
    fs.mkdirSync(path.dirname(dbPath), { recursive: true });
    db = new Database(dbPath);
  } catch { /* TF-IDF only */ }

  try {
    const result = await compileSurface({
      vaultDir, skillsDir, derivedDir,
      instructionsFile: dryRun ? null : instructionsFile,
      db,
    });
    console.log(`✅ Nodes: ${result.nodes.length} | Skills: ${result.skills.length} | Routes: ${result.routes.length}`);
    if (dryRun) {
      console.log('\n[DRY RUN] Tier 1 preview:\n');
      console.log(result.tier1Instructions.slice(0, 600));
      console.log('\n⚠️  Nothing written.\n');
    } else {
      console.log(`   Written: ${path.relative(ROOT, instructionsFile)}\n`);
    }
  } catch (err) {
    console.error(`\n❌ Compile failed: ${err.message}\n`);
    process.exit(1);
  } finally {
    if (db) db.close();
  }
}

// ─── MIGRATE ─────────────────────────────────────────────────────────────────────

async function runMigrate(paths, migrateArgs) {
  const sourceIdx = migrateArgs.indexOf('--source');
  const sourceDir = sourceIdx !== -1 ? migrateArgs[sourceIdx + 1]
    : paths.wikiDir ?? path.join(paths.dataDir, 'memory-wiki');
  const vaultDir = migrateArgs.indexOf('--vault') !== -1
    ? migrateArgs[migrateArgs.indexOf('--vault') + 1]
    : paths.vaultDir ?? path.join(paths.dataDir, 'memory-vault');
  const execute = migrateArgs.includes('--execute');

  const migrateScript = path.resolve(
    path.dirname(new URL(import.meta.url).pathname), '..', 'scripts', 'migrate-nodes.mjs'
  );
  const { spawnSync } = await import('child_process');
  const result = spawnSync(process.execPath, [
    migrateScript, execute ? '--execute' : '--dry-run',
    '--source', sourceDir, '--vault', vaultDir,
  ], { stdio: 'inherit' });
  process.exit(result.status ?? 0);
}

// ─── RESOLVE ─────────────────────────────────────────────────────────────────────

async function runResolve(paths, resolveArgs) {
  const { cliResolve } = await import('../src/core/steering.mjs');
  const vaultDir = paths.vaultDir ?? path.join(paths.dataDir, 'memory-vault');
  const conflictsDir = path.join(paths.dataDir, 'memory-inbox', 'conflicts');

  const argMap = {};
  for (let i = 0; i < resolveArgs.length; i++) {
    if (resolveArgs[i].startsWith('--')) { argMap[resolveArgs[i].slice(2)] = resolveArgs[i + 1]; i++; }
  }

  if (!argMap['conflict-id']) {
    // List mode
    if (!fs.existsSync(conflictsDir)) { console.log('✅ No conflicts.\n'); return; }
    const files = fs.readdirSync(conflictsDir).filter(f => f.endsWith('.md'));
    if (files.length === 0) { console.log('✅ No pending conflicts.\n'); return; }
    console.log(`\n⚠️  Pending Conflicts (${files.length}):\n`);
    for (const f of files) {
      const raw = fs.readFileSync(path.join(conflictsDir, f), 'utf-8');
      const m = raw.match(/reason:\s*['"]?(.+?)['"]?\n/);
      console.log(`  📄 ${f.replace('.md', '')}`);
      if (m) console.log(`     ${m[1].slice(0, 100)}`);
    }
    console.log('\nUsage: total-recall resolve --conflict-id <id> --keep <slug>\n');
    return;
  }

  try { cliResolve(argMap, vaultDir, conflictsDir); }
  catch (err) { console.error(`❌ ${err.message}\n`); process.exit(1); }
}

// ─── CONFLICTS LIST ───────────────────────────────────────────────────────────────

async function runConflicts(paths) { await runResolve(paths, []); }

// ─── DAEMON ───────────────────────────────────────────────────────────────────────

const DAEMON_PID_FILE = path.join(os.homedir(), '.total-recall', 'daemon.pid');

async function runDaemon(paths, config, daemonArgs) {
  const sub = daemonArgs[0];
  const vaultDir = paths.vaultDir ?? path.join(paths.dataDir, 'memory-vault');
  const skillsDir = paths.skillsDir ?? path.join(ROOT, '.agent', 'skills');
  const derivedDir = paths.derivedDir ?? path.join(paths.dataDir, 'memory-derived');
  const sessionsDir = paths.sessionsDir ?? path.join(paths.dataDir, 'sessions');
  const conflictsDir = path.join(paths.dataDir, 'memory-inbox', 'conflicts');
  const backupsDir = path.join(paths.dataDir, '.backups');
  const instructionsFile = paths.instructionsFile
    ?? path.join(ROOT, config.systemPromptFile ?? 'INSTRUCTIONS.md');
  const schedule = config.coprocessor?.schedule ?? '0 3 * * *';

  if (sub === 'start') {
    if (fs.existsSync(DAEMON_PID_FILE)) {
      const existingPid = fs.readFileSync(DAEMON_PID_FILE, 'utf-8').trim();
      try { process.kill(parseInt(existingPid), 0); console.log(`⚠️  Daemon already running (PID ${existingPid}).\n`); return; }
      catch { fs.unlinkSync(DAEMON_PID_FILE); }
    }
    const dreamPath = path.resolve(path.dirname(new URL(import.meta.url).pathname), '..', 'src', 'core', 'dream.mjs');
    const daemonConfig = JSON.stringify({ vaultDir, skillsDir, derivedDir, sessionsDir, conflictsDir, backupsDir, instructionsFile, schedule });
    const { spawn } = await import('child_process');
    const child = spawn(process.execPath, ['--input-type=module', '--eval',
      `import { startDaemon } from '${dreamPath}'; await startDaemon(${daemonConfig});`
    ], { detached: true, stdio: 'ignore' });
    child.unref();
    fs.mkdirSync(path.dirname(DAEMON_PID_FILE), { recursive: true });
    fs.writeFileSync(DAEMON_PID_FILE, String(child.pid));
    console.log(`🌙 Daemon started (PID ${child.pid}) — schedule: ${schedule} UTC\n`);

  } else if (sub === 'stop') {
    if (!fs.existsSync(DAEMON_PID_FILE)) { console.log('⚠️  No daemon running.\n'); return; }
    const pid = parseInt(fs.readFileSync(DAEMON_PID_FILE, 'utf-8').trim(), 10);
    try { process.kill(pid, 'SIGTERM'); console.log(`🛑 Daemon stopped (PID ${pid})\n`); }
    catch { console.log(`⚠️  PID ${pid} already gone.\n`); }
    fs.unlinkSync(DAEMON_PID_FILE);

  } else if (sub === 'status') {
    const alive = fs.existsSync(DAEMON_PID_FILE);
    const reportPath = path.join(derivedDir, 'dream-report.jsonl');
    let last = null;
    if (fs.existsSync(reportPath)) {
      const lines = fs.readFileSync(reportPath, 'utf-8').trim().split('\n').filter(Boolean);
      try { last = JSON.parse(lines[lines.length - 1]); } catch {}
    }
    console.log('\n🌙 Dream Daemon Status\n');
    console.log(`   Status:    ${alive ? `🟢 Running (PID ${fs.readFileSync(DAEMON_PID_FILE, 'utf-8').trim()})` : '⚫ Not running'}`);
    if (last) {
      console.log(`   Last run:  ${last.timestamp}`);
      console.log(`   Duration:  ${last.duration_ms}ms`);
      console.log(`   Processed: ${last.nodes_processed} nodes | Promoted: ${last.nodes_promoted} | Decayed: ${last.nodes_decayed} | Conflicts: ${last.conflicts_found}`);
      if (last.errors?.length) console.log(`   Errors:    ${last.errors.join('; ')}`);
    } else {
      console.log('   Last run:  Never');
    }
    console.log('');

  } else {
    console.log('Usage: total-recall daemon start|stop|status\n');
  }
}

// ─── COMPILE SURFACE (LEGACY — kept for backwards compat) ────────────────────────

async function runCompileSurface(paths, config) {
  const { compileSurface, writeSurface } = await import('../src/core/surface.mjs');

  const preview = args.includes('--preview');
  const statsOnly = args.includes('--stats');

  const result = compileSurface({
    wikiDir: paths.wikiDir,
    root: paths.root,
    ranking: config.ranking,
  });

  if (!result) {
    console.log('📭 No wiki nodes with frontmatter found.\n');
    return;
  }

  if (statsOnly) {
    console.log('📊 Behavioral Surface — Ranking Details\n');
    console.log(`Total nodes: ${result.stats.totalNodes}`);
    console.log(`Negative: ${result.stats.negativeRules} | Positive: ${result.stats.positiveRules} | Corrective: ${result.stats.correctiveRules}`);
    console.log(`Steered: ${result.stats.steeredNodes}\n`);
    for (const n of result.nodes.slice(0, 15)) {
      console.log(`  ${n.score.toFixed(2)} | [${n.type}/${n.sentiment}] ${n.title}`);
    }
    return;
  }

  if (preview) {
    console.log('🔮 Preview:\n');
    console.log('─'.repeat(60));
    console.log(result.surface);
    console.log('─'.repeat(60));
    return;
  }

  if (paths.systemPromptFiles && paths.systemPromptFiles.length > 0) {
    const { writeSurfaceMulti } = await import('../src/core/surface.mjs');
    const writeResult = writeSurfaceMulti(
      paths.systemPromptFiles,
      result.surface,
      config.behavioralSurfaceHeader,
    );
    
    const allSuccess = writeResult.results.every(r => r.success);
    if (allSuccess) {
      console.log('✅ Behavioral Surface written to', paths.systemPromptFiles.map(p => path.relative(ROOT, p)).join(', '));
      console.log(`   ${result.stats.totalNodes} nodes → ${result.stats.negativeRules} negative, ${result.stats.positiveRules} positive\n`);
    } else {
      console.log(`❌ Some files failed to write: ${JSON.stringify(writeResult.results)}\n`);
    }
  } else {
    console.log(`❌ No systemPromptFiles configured.\n`);
  }
}

// ─── LINT ───────────────────────────────────────────────────────────────────────

async function runLint(paths) {
  const { lint } = await import('../src/core/wiki.mjs');
  const result = lint(paths.wikiDir);

  console.log(`🔍 Wiki Lint — ${result.pages} pages\n`);

  if (result.issues.errors.length > 0) {
    console.log(`🔴 ERRORS (${result.issues.errors.length}):`);
    for (const e of result.issues.errors) console.log(`  ❌ [${e.type}] ${e.slug}: ${e.detail}`);
    console.log('');
  }

  if (result.issues.warnings.length > 0) {
    console.log(`🟡 WARNINGS (${result.issues.warnings.length}):`);
    for (const w of result.issues.warnings) console.log(`  ⚠️  [${w.type}] ${w.slug}: ${w.detail}`);
    console.log('');
  }

  if (result.issues.info.length > 0) {
    console.log(`🔵 INFO (${result.issues.info.length}):`);
    for (const i of result.issues.info) console.log(`  ℹ️  [${i.type}] ${i.slug}: ${i.detail}`);
    console.log('');
  }

  const total = result.issues.errors.length + result.issues.warnings.length + result.issues.info.length;
  if (total === 0) {
    console.log('✅ Wiki is healthy.\n');
  } else if (result.hasErrors) {
    console.log('⛔ Fix all errors before proceeding.\n');
    process.exit(1);
  } else {
    console.log('✅ No blocking errors.\n');
  }
}

