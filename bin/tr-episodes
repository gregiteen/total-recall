#!/usr/bin/env node

/**
 * tr-episodes — Total Recall Episode Archive CLI
 *
 * Usage:
 *   tr-episodes backfill [--limit N]     Backfill episodes from brain conversations
 *   tr-episodes backfill-handoffs        Backfill episodes from handoff archives
 *   tr-episodes stats                    Show episode archive statistics
 *   tr-episodes list                     List all archived episodes
 */

import path from 'path';
import { fileURLToPath } from 'url';
import { loadConfig, resolvePaths } from '../src/core/utils.mjs';
import { backfillFromBrain, backfillFromHandoffs, listEpisodes, getEpisodeStats } from '../src/core/episodes.mjs';
import { openDatabase, reindex as fts5Reindex } from '../src/core/fts5.mjs';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const command = process.argv[2];
const flags = process.argv.slice(3);

// Parse --root flag
let root = process.cwd();
const rootIdx = flags.indexOf('--root');
if (rootIdx !== -1 && flags[rootIdx + 1]) {
  root = flags[rootIdx + 1];
}

async function main() {
  const config = await loadConfig(root);
  const paths = resolvePaths(root, config);

  // Resolve brain directory (Antigravity default)
  const brainDir = path.join(process.env.HOME, '.gemini/antigravity/brain');

  // Handoff source directory (in the repo)
  const handoffsSourceDir = path.join(root, '.agent/handoffs');

  switch (command) {
    case 'backfill': {
      console.log('🧠 Backfilling episodes from brain conversations...');
      console.log(`   Brain: ${brainDir}`);
      console.log(`   Episodes: ${paths.episodesDir}\n`);

      const limitIdx = flags.indexOf('--limit');
      const limit = limitIdx !== -1 ? parseInt(flags[limitIdx + 1] || '0') : 0;

      const stats = backfillFromBrain(brainDir, paths.episodesDir, { limit });
      console.log(`✅ Backfill complete:`);
      console.log(`   Total conversations: ${stats.total}`);
      console.log(`   Episodes created: ${stats.created}`);
      console.log(`   Skipped: ${stats.skipped}`);
      console.log(`   Errors: ${stats.errors}`);

      if (stats.created > 0) {
        console.log('\n📇 Reindexing FTS5...');
        const db = openDatabase(paths.dbPath);
        const indexResult = fts5Reindex(db, paths);
        console.log(`   Indexed ${indexResult.totalIndexed} items (${indexResult.breakdown.episodes} episodes)`);
        db.close();
      }
      break;
    }

    case 'backfill-handoffs': {
      console.log('📁 Backfilling episodes from handoff archives...');
      console.log(`   Handoffs: ${handoffsSourceDir}`);
      console.log(`   Episodes: ${paths.episodesDir}\n`);

      const stats = backfillFromHandoffs(handoffsSourceDir, paths.episodesDir);
      console.log(`✅ Handoff backfill complete:`);
      console.log(`   Total handoffs: ${stats.total}`);
      console.log(`   Episodes created: ${stats.created}`);
      console.log(`   Skipped: ${stats.skipped}`);
      console.log(`   Errors: ${stats.errors}`);

      if (stats.created > 0) {
        console.log('\n📇 Reindexing FTS5...');
        const db = openDatabase(paths.dbPath);
        const indexResult = fts5Reindex(db, paths);
        console.log(`   Indexed ${indexResult.totalIndexed} items (${indexResult.breakdown.episodes} episodes)`);
        db.close();
      }
      break;
    }

    case 'stats': {
      const epStats = getEpisodeStats(paths.episodesDir);
      console.log('📊 Episode Archive Statistics\n');
      console.log(`   Total episodes: ${epStats.total}`);
      console.log(`   Oldest: ${epStats.oldestDate || 'N/A'}`);
      console.log(`   Newest: ${epStats.newestDate || 'N/A'}`);

      if (Object.keys(epStats.byMonth).length > 0) {
        console.log('\n   By month:');
        for (const [month, count] of Object.entries(epStats.byMonth).sort()) {
          console.log(`     ${month}: ${count} episodes`);
        }
      }
      break;
    }

    case 'list': {
      const episodes = listEpisodes(paths.episodesDir);
      if (episodes.length === 0) {
        console.log('📭 No episodes archived yet. Run `tr-episodes backfill` first.');
      } else {
        console.log(`📚 ${episodes.length} archived episodes:\n`);
        for (const ep of episodes.slice(-20)) {
          const relative = path.relative(paths.episodesDir, ep);
          console.log(`   ${relative}`);
        }
        if (episodes.length > 20) {
          console.log(`\n   ... and ${episodes.length - 20} more`);
        }
      }
      break;
    }

    default:
      console.log(`Usage: tr-episodes <command>

Commands:
  backfill [--limit N]     Backfill episodes from brain conversations
  backfill-handoffs        Backfill episodes from handoff archives
  stats                    Show episode archive statistics
  list                     List all archived episodes`);
  }
}

main().catch(err => {
  console.error('❌ Error:', err.message);
  process.exit(1);
});
