{
  "name": "total-recall-brain",
  "version": "3.14.3",
  "description": "Personal AI system — database-free, SSSS-powered intelligence engine deployable to any POSIX host.",
  "type": "module",
  "bin": {
    "total-recall": "bin/total-recall.mjs",
    "antigravity": "bin/antigravity.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.spec.mjs",
    "!src/**/*.test.mjs",
    "frontend/dist/",
    "frontend/package.json",
    "frontend/vite.config.ts",
    "frontend/tsconfig*.json",
    "frontend/index.html",
    "frontend/src/",
    "extension/",
    "templates/",
    "scaffold/",
    "docs/ARCHITECTURE.md",
    "docs/IDE_INTEGRATION.md",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": "./src/server/index.mjs",
    "./fixtures/*": "./fixtures/*",
    "./src/core/*": "./src/core/*"
  },
  "scripts": {
    "dev": "node src/server/index.mjs",
    "start": "node src/server/index.mjs",
    "test": "vitest run",
    "clean": "rm -rf scratch/* .remember/* *.log",
    "version": "node .agent/skills/push/scripts/sync-skill-versions.mjs && git add scaffold/.agent/skills/total-recall/SKILL.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregiteen/total-recall.git"
  },
  "keywords": [
    "ai",
    "ssss",
    "memory",
    "local-llm"
  ],
  "author": "gregiteen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gregiteen/total-recall/issues"
  },
  "homepage": "https://github.com/gregiteen/total-recall#readme",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@ssss/cli": "github:gregiteen/ssss#main",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "gray-matter": "^4.0.3",
    "jsonwebtoken": "^9.0.3",
    "natural": "^8.1.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "openwiki": "^0.0.1",
    "skills": "^1.5.7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "playwright": "^1.60.0"
  }
}
