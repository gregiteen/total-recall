{
  "name": "total-recall-brain",
  "version": "3.39.1",
  "description": "Portable SSSS memory, local retrieval and task instructions with explicit plugin loading.",
  "type": "module",
  "bin": {
    "total-recall": "bin/total-recall.mjs",
    "antigravity": "bin/antigravity.mjs",
    "total-recall-memory": "bin/total-recall-memory.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "!src/**/*.spec.mjs",
    "!src/**/*.test.mjs",
    "frontend/dist/",
    "frontend/package.json",
    "frontend/vite.config.ts",
    "frontend/tsconfig*.json",
    "frontend/index.html",
    "frontend/src/",
    "!frontend/**/*.spec.ts",
    "!frontend/**/*.spec.tsx",
    "!frontend/**/*.test.ts",
    "!frontend/**/*.test.tsx",
    "extension/",
    "templates/",
    "scaffold/",
    "docs/ARCHITECTURE.md",
    "docs/IDE_INTEGRATION.md",
    "docs/reference/cli-reference.md",
    "docs/reference/CLI_INVENTORY.md",
    "docs/SSSS.md",
    "README.md",
    "LICENSE",
    "package.json",
    "metadata.plugin.schema.json"
  ],
  "exports": {
    ".": "./src/server/index.mjs",
    "./fixtures/*": "./fixtures/*",
    "./src/core/*": "./src/core/*",
    "./memory": "./src/server/memory-app.mjs",
    "./src/core/secrets-store.mjs": "./src/core/secrets-store.mjs"
  },
  "scripts": {
    "dev": "node src/server/index.mjs",
    "start": "node src/server/index.mjs",
    "test": "vitest run",
    "routes:manifest": "node scripts/generate-route-manifest.mjs",
    "clean": "rm -rf scratch/* .remember/* *.log",
    "check:dist": "node scripts/check-dist-freshness.mjs",
    "prepublishOnly": "npm run check:package && npm run check:dist && npm run check:ssss-registry && node scripts/check-scaffold-state.mjs",
    "check:ssss-registry": "node scripts/check-ssss-registry.mjs",
    "check:package": "node scripts/check-memory-package.mjs",
    "start:memory": "node src/server/memory-server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gregiteen/total-recall.git"
  },
  "keywords": [
    "ai",
    "ssss",
    "memory",
    "local-llm"
  ],
  "author": "gregiteen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gregiteen/total-recall/issues"
  },
  "homepage": "https://github.com/gregiteen/total-recall#readme",
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@ssss/cli": "npm:@gregiteen/ssss-cli@0.10.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "d3-selection": "^3.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "natural": "^8.1.1",
    "preact": "^10.29.7",
    "sqlite-vss": "^0.1.2",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "skills": "^1.5.7",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11",
    "gray-matter": "^4.0.3"
  },
  "workspaces": [
    "frontend"
  ],
  "optionalDependencies": {
    "playwright": "^1.60.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "argparse": "2.0.1"
  }
}
