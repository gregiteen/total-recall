{
  "apps": [
    {
      "name": "memory-coprocessor",
      "script": "./src/coprocessor/daemon.mjs",
      "args": "--root /Users/greg/Github/ultrachat-ai-powered",
      "cwd": "/Users/greg/Github/total-recall",
      "max_memory_restart": "200M",
      "autorestart": true,
      "watch": false,
      "node_args": "--experimental-vm-modules",
      "env": {
        "NODE_ENV": "production"
      },
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "/tmp/total-recall-coprocessor-pm2-err.log",
      "out_file": "/tmp/total-recall-coprocessor-pm2-out.log",
      "merge_logs": true,
      "kill_timeout": 5000,
      "listen_timeout": 3000
    }
  ]
}
